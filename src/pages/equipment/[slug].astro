---
import Base from '../../layouts/Base.astro';
import Scatter from '../../components/Scatter.astro';
import { equipment } from '../../data/equipment';
import { metrics, domains } from '../../data/taxonomy';
import { eraOf, groupById, groupUrl, itemsOfGroup, itemUrl, formatNumber, rankInGroup } from '../../lib/data';

export function getStaticPaths() {
  return equipment.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const era = eraOf(item.year);
const group = groupById(item.group);
const domain = domains.find((d) => d.id === group.domain)!;
const peers = itemsOfGroup(group.id);
const specRows = group.metrics
  .filter((metric) => item.specs[metric] !== undefined)
  .map((metric) => {
    const value = item.specs[metric] as number;
    const max = Math.max(...peers.map((p) => p.specs[metric] ?? 0), 1);
    return { metric, value, share: (value / max) * 100, rank: rankInGroup(item, metric) };
  });
const others = peers.filter((p) => p.id !== item.id);
---
<Base title={item.name} era={era.id} description={`${item.name} (${item.country}, ${item.year}): ${item.text}`}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Навигация">
      <a href="/">Главная</a><span>/</span>
      <a href={`/periods/${era.id}/`}>{era.name}</a><span>/</span>
      <a href={`/periods/${era.id}/${domain.id}/`}>{domain.name}</a><span>/</span>
      <a href={groupUrl(era.id, group)}>{group.name}</a><span>/</span>
      <span>{item.name}</span>
    </nav>
  </div>

  <section class="section" style={`--c:var(--era-${era.id})`}>
    <div class="wrap">
      <div class="section-head">
        <span class="stripe"></span>
        <span class="eyebrow">{group.name}</span>
        <h1>{item.name}</h1>
        <p class="lead">{item.text}</p>
      </div>
      <dl class="facts">
        <div><dt>Страна</dt><dd>{item.country}</dd></div>
        <div><dt>Принят на вооружение</dt><dd class="num">{item.year}</dd></div>
        <div><dt>Период</dt><dd>{era.name}</dd></div>
        <div><dt>Группа</dt><dd>{group.name}</dd></div>
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Характеристики</h2>
        <p class="lead">Шкала показывает значение относительно самого большого в группе «{group.name}».</p>
      </div>
      <div class="specs" data-reveal style={`--c:var(--era-${era.id})`}>
        {specRows.map(({ metric, value, share, rank }) => (
          <div class="spec">
            <span class="eyebrow">{metrics[metric].label}</span>
            <span class="value">≈{formatNumber(value)}<small>{metrics[metric].unit}</small></span>
            <span class="gauge"><i style={`--w:${share}%`}></i></span>
            {rank && <span class="rank">{rank.rank}-е место из {rank.total} в группе</span>}
          </div>
        ))}
      </div>
    </div>
  </section>

  {specRows.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <h2>Место среди аналогов</h2>
          <p class="lead">Все модели группы на одной шкале времени.</p>
        </div>
        <div class="cards" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));">
          {group.metrics.filter((m) => item.specs[m] !== undefined).map((metric) => (
            <Scatter items={peers} metric={metric} highlight={item.id} />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Другие в группе</h2>
      </div>
      {others.length > 0 ? (
        <div class="cards">
          {others.map((other) => (
            <a class="card" href={itemUrl(other)} style={`--c:var(--era-${eraOf(other.year).id})`}>
              <span class="stripe"></span>
              <h3>{other.name}</h3>
              <span class="meta num">{other.year} · {other.country}</span>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty">Других моделей в этой группе пока нет.</p>
      )}
      <p class="notice" style="margin-top: 32px;">
        Значения округлены и приведены по открытым источникам. Подробности: <a href="/sources/">источники и методика</a>.
        Страница модели в Википедии: <a href={`https://en.wikipedia.org/wiki/${item.wiki}`} rel="noopener" target="_blank">открыть</a>.
      </p>
    </div>
  </section>
</Base>
