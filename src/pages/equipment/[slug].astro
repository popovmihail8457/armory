---
import Base from '../../layouts/Base.astro';
import Scatter from '../../components/Scatter.astro';
import RadarDemo from '../../components/RadarDemo.astro';
import ArmamentMap from '../../components/ArmamentMap.astro';
import DefenseDemo from '../../components/DefenseDemo.astro';
import StorySection from '../../components/StorySection.astro';
import TrajectoryDemo from '../../components/TrajectoryDemo.astro';
import CoverageDiagram from '../../components/CoverageDiagram.astro';
import OperationsReel from '../../components/OperationsReel.astro';
import BallisticsLab from '../../components/BallisticsLab.astro';
import ShipExplorer from '../../components/ShipExplorer.astro';
import SensorScope from '../../components/SensorScope.astro';
import NavalLaunchDemo from '../../components/NavalLaunchDemo.astro';
import ArmorDemo from '../../components/ArmorDemo.astro';
import HangarDemo from '../../components/HangarDemo.astro';
import { armorOf, armorSchemes } from '../../data/armor';
import { hangars } from '../../data/hangars';
import { armorDetails } from '../../data/armor-details';
import VariantSwitch from '../../components/VariantSwitch.astro';
import { variantsOf } from '../../data/variants';
import { shipSchemes, launchScenes } from '../../data/ships';
import { fleetSchemes } from '../../data/ships-fleet';
import { samSensors, type Sensor } from '../../data/sensors';
import { gunsOfPlatform, shellsOfGun, shellTypeById } from '../../data/shells';
import { operations } from '../../data/operations';
import { videos } from '../../data/videos';
import { bgForItem } from '../../lib/bg';
import { coverageFor } from '../../data/coverage';
import { equipmentScene } from '../../data/trajectory';
import { stories } from '../../data/stories';
import { weaponsForPlatform, weaponUrl } from '../../lib/weapons';
import { weaponMetrics } from '../../data/weapons/taxonomy';
import { defenseByItem, kindName } from '../../data/defense';
import { armament } from '../../data/armament';
import { aircraftRadar } from '../../data/radar';
import { equipment } from '../../data/equipment';
import { metrics, domains } from '../../data/taxonomy';
import { eraOf, groupById, groupUrl, itemsOfGroup, itemUrl, formatNumber, rankInGroup } from '../../lib/data';

export function getStaticPaths() {
  return equipment.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const era = eraOf(item.year);
const group = groupById(item.group);
const domain = domains.find((d) => d.id === group.domain)!;
const peers = itemsOfGroup(group.id);
const specRows = group.metrics
  .filter((metric) => item.specs[metric] !== undefined)
  .map((metric) => {
    const value = item.specs[metric] as number;
    const max = Math.max(...peers.map((p) => p.specs[metric] ?? 0), 1);
    return { metric, value, share: (value / max) * 100, rank: rankInGroup(item, metric) };
  });
const others = peers.filter((p) => p.id !== item.id);
const radar = aircraftRadar[item.id];
const arms = armament[item.id];
const story = stories[item.id];
const usedWeapons = weaponsForPlatform(item.id);
const ops = operations[item.id] ?? [];
const clips = videos[item.id] ?? [];
const itemPhoto = bgForItem(item.id);
const isAircraft = domain.id === 'aviation';
const cov = isAircraft ? coverageFor(item.id) : undefined;
const defense = defenseByItem[item.id];
const itemGuns = gunsOfPlatform(item.id);
const ship = shipSchemes[item.id] ?? fleetSchemes[item.id];
const shipSensors = ship ? ship.modules.map((module) => module.sensor).filter((sensor): sensor is Sensor => Boolean(sensor)) : [];
const sensors = shipSensors.length > 0 ? shipSensors : samSensors[item.id] ?? [];
const launches = launchScenes[item.id] ?? [];
const trajScene = equipmentScene(item, launches.length > 0);
const armor = armorSchemes.find((scheme) => scheme.id === armorOf[item.id]);
const hangar = hangars[item.id];
const variantList = variantsOf(item, story?.variants);
const defenseScenes = defense ? [...new Set(defense.map((d) => d.scene))] : [];
const placeWord = { aviation: 'Ангар', fleet: 'Док', ground: 'Бокс' }[domain.id];
const tocItems = [
  variantList.length > 0 && { id: 'variants', label: 'Версии' },
  story && { id: 'story', label: 'История' },
  ops.length > 0 && { id: 'operations', label: 'Операции' },
  { id: 'specs', label: 'Характеристики' },
  armor && { id: 'armor', label: 'Броня' },
  hangar && { id: 'hangar', label: 'Ангар' },
  ship && { id: 'ship', label: 'Схема корабля' },
  sensors.length > 0 && { id: 'sensors', label: 'Радары и секторы' },
  launches.length > 0 && { id: 'launch', label: 'Пуск ракет' },
  arms && { id: 'armament', label: 'Вооружение' },
  trajScene && { id: 'trajectory', label: 'Траектория' },
  itemGuns.length > 0 && { id: 'shells', label: 'Снаряды и баллистика' },
  usedWeapons.length > 0 && { id: 'weapons-used', label: 'Применяемое оружие' },
  isAircraft && { id: 'coverage', label: 'Углы обзора' },
  defense && { id: 'defense', label: 'Защита' },
  radar && { id: 'radar', label: 'Радар' },
  specRows.length > 0 && { id: 'compare', label: 'Аналоги' },
].filter(Boolean) as { id: string; label: string }[];---
<Base title={item.name} vt={domain.id} place={`${placeWord} · ${group.name} · ${item.name}`} era={era.id} photoUrl={itemPhoto} noPhoto={!itemPhoto} description={`${item.name} (${item.country}, ${item.year}): ${item.text}`}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Навигация">
      <a href="/">Главная</a><span>/</span>
      <a href={`/periods/${era.id}/`}>{era.name}</a><span>/</span>
      <a href={`/periods/${era.id}/${domain.id}/`}>{domain.name}</a><span>/</span>
      <a href={groupUrl(era.id, group)}>{group.name}</a><span>/</span>
      <span>{item.name}</span>
    </nav>
  </div>

  <section class="section" style={`--c:var(--era-${era.id})`}>
    <div class="wrap">
      <div class="section-head">
        <span class="stripe"></span>
        <span class="eyebrow">{group.name}</span>
        <h1>{item.name}</h1>
        <p class="lead">{item.text}</p>
      </div>
      <dl class="facts">
        <div><dt>Страна</dt><dd>{item.country}</dd></div>
        <div><dt>Принят на вооружение</dt><dd class="num">{item.year}</dd></div>
        <div><dt>Период</dt><dd>{era.name}</dd></div>
        <div><dt>Группа</dt><dd>{group.name}</dd></div>
      </dl>
    </div>
  </section>

  <nav class="toc" aria-label="Разделы страницы">
    <div class="wrap">
      {tocItems.map((t) => <a href={'#' + t.id}>{t.label}</a>)}
    </div>
  </nav>

  {variantList.length > 0 && (
    <section class="section" id="variants" style={`--c:var(--era-${era.id})`}>
      <div class="wrap">
        <div class="section-head">
          <h2>{variantList.length > 1 ? 'Версии' : 'Основная версия'}</h2>
          <p class="lead">{variantList.length > 1 ? 'Выберите версию: изменятся описание, характеристики, радиолокатор и состав вооружения. Числа рядом со значением показывают разницу с первой версией.' : 'Радиолокатор и состав вооружения серийной версии.'}</p>
        </div>
        <VariantSwitch item={item} list={variantList} metricIds={group.metrics} baseWeapons={usedWeapons} />
      </div>
    </section>
  )}

  {story && (
    <section class="section" id="story">
      <div class="wrap">
        <div class="section-head">
          <h2>О машине</h2>
        </div>
        <StorySection story={story} year={item.year} country={item.country} eraId={era.id} />
      </div>
    </section>
  )}

  {ops.length > 0 && (
    <section class="section reel-section" id="operations" style={`--c:var(--era-${era.id})`}>
      <div class="wrap">
        <div class="section-head">
          <h2>Участие в операциях</h2>
          <p class="lead">{clips.length > 0 ? 'Прокручивайте вниз: за карточками идёт видео с применением техники.' : 'Основные операции, в которых применялась эта техника.'}</p>
        </div>
      </div>
      <OperationsReel ops={ops} clips={clips} />
    </section>
  )}

  <section class="section" id="specs">
    <div class="wrap">
      <div class="section-head">
        <h2>Характеристики</h2>
        <p class="lead">Шкала показывает значение относительно самого большого в группе «{group.name}».</p>
      </div>
      <div class="specs" data-reveal style={`--c:var(--era-${era.id})`}>
        {specRows.map(({ metric, value, share, rank }) => (
          <div class="spec">
            <span class="eyebrow">{metrics[metric].label}</span>
            <span class="value">≈{formatNumber(value)}<small>{metrics[metric].unit}</small></span>
            <span class="gauge"><i style={`--w:${share}%`}></i></span>
            {rank && <span class="rank">{rank.rank}-е место из {rank.total} в группе</span>}
          </div>
        ))}
      </div>
    </div>
  </section>

  {armor && (
    <section class="section" id="armor" style={`--c:var(--era-${era.id})`}>
      <div class="wrap">
        <div class="section-head">
          <h2>Броня: из чего состоит и как работает</h2>
          <p class="lead">Выберите боеприпас, чтобы увидеть, какой слой что делает. Нажмите на слой на схеме или в списке, чтобы прочитать о нём.</p>
        </div>
        <ArmorDemo scheme={armor} detail={armorDetails[item.id]} name={item.name} />
      </div>
    </section>
  )}

  {hangar && (
    <section class="section" id="hangar" style={`--c:var(--era-${era.id})`}>
      <div class="wrap">
        <div class="section-head">
          <h2>Ангар: что и сколько помещается</h2>
          <p class="lead">Меняйте состав авиагруппы кнопками: схема покажет, сколько машин встаёт в ангар, а сколько остаётся на полётной палубе.</p>
        </div>
        <HangarDemo hangar={hangar} />
      </div>
    </section>
  )}

  {ship && (
    <section class="section" id="ship" style={`--c:var(--era-${era.id})`}>
      <div class="wrap">
        <div class="section-head">
          <h2>Схема корабля и системы</h2>
          <p class="lead">Нажмите на номер на силуэте или на строку списка, чтобы открыть характеристики радара, пусковой установки или орудия.</p>
        </div>
        <ShipExplorer scheme={ship} name={item.name} />
      </div>
    </section>
  )}

  {sensors.length > 0 && (
    <section class="section" id="sensors" style={`--c:var(--era-${era.id})`}>
      <div class="wrap">
        <div class="section-head">
          <h2>Радары и секторы обзора</h2>
          <p class="lead">{ship ? 'Вид сверху: какой сектор просматривает каждая станция и как она его обходит.' : 'Вид сверху: станции обнаружения дают круговой обзор, а станции наведения работают в секторе или узким лучом.'}</p>
        </div>
        <SensorScope sensors={sensors} forward={ship ? 'Нос' : 'Ось комплекса'} />
      </div>
    </section>
  )}

  {launches.length > 0 && (
    <section class="section" id="launch" style={`--c:var(--era-${era.id})`}>
      <div class="wrap">
        <div class="section-head">
          <h2>Выход ракет на траекторию</h2>
          <p class="lead">Упрощённая схема: как ракета покидает пусковую установку и ложится на курс к цели.</p>
        </div>
        <NavalLaunchDemo scenes={launches} />
      </div>
    </section>
  )}

  {arms && (
    <section class="section" id="armament">
      <div class="wrap">
        <div class="section-head">
          <h2>Вооружение</h2>
          <p class="lead">Наведите курсор на строку или номер на фото, чтобы увидеть, где что расположено.</p>
        </div>
        <ArmamentMap entry={arms} />
      </div>
    </section>
  )}

  {trajScene && (
    <section class="section" id="trajectory">
      <div class="wrap">
        <div class="section-head">
          <h2>Траектория</h2>
          <p class="lead">Упрощённая анимация показывает принцип полёта и наведения. Реальные профили зависят от версии и условий применения.</p>
        </div>
        <TrajectoryDemo only={[trajScene]} initial={trajScene} />
      </div>
    </section>
  )}

  {itemGuns.length > 0 && (
    <section class="section" id="shells" style={`--c:var(--era-${era.id})`}>
      <div class="wrap">
        <div class="section-head">
          <h2>Снаряды и баллистика</h2>
          <p class="lead">Типы снарядов к орудиям этой машины. Выберите снаряд и угол ствола: график покажет траекторию, скорость и время полёта.</p>
        </div>
        {itemGuns.map((gun) => (
          <div class="shell-group">
            <h3>{gun.name}</h3>
            <ul class="shell-list">
              {shellsOfGun(gun.id).map((shell) => (
                <li>
                  <abbr class="eyebrow" title={shellTypeById(shell.type).name}>{shellTypeById(shell.type).short}</abbr>
                  <div><strong>{shell.name}</strong><span>{shell.note}</span></div>
                  <span class="num">{shell.v0 ? `≈${formatNumber(shell.v0)} м/с` : 'управляемая'}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
        <BallisticsLab gunIds={itemGuns.map((gun) => gun.id)} />
        <p style="margin-top: 16px;"><a href="/ballistics/">Все орудия и сравнительные таблицы на странице баллистики</a></p>
      </div>
    </section>
  )}

  {usedWeapons.length > 0 && (
    <section class="section" id="weapons-used">
      <div class="wrap">
        <div class="section-head">
          <h2>Применяемое вооружение</h2>
          <p class="lead">Образцы из каталога, которые используются этой машиной. На странице каждого образца есть принцип работы и модификации.</p>
        </div>
        <div class="cards">
          {usedWeapons.map((w) => (
            <a class="card" href={weaponUrl(w)} style={`--c:var(--era-${eraOf(w.year).id}`}>
              <span class="stripe"></span>
              <h3>{w.name}</h3>
              <span class="meta num">{w.year} · {w.country}</span>
              <span class="desc">{w.type}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {specRows.length > 0 && (
    <section class="section" id="compare">
      <div class="wrap">
        <div class="section-head">
          <h2>Место среди аналогов</h2>
          <p class="lead">Все модели группы на одной шкале времени.</p>
        </div>
        <div class="cards" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));">
          {group.metrics.filter((m) => item.specs[m] !== undefined).map((metric) => (
            <Scatter items={peers} metric={metric} highlight={item.id} />
          ))}
        </div>
      </div>
    </section>
  )}

  {cov && (
    <section class="section" id="coverage">
      <div class="wrap">
        <div class="section-head">
          <h2>Углы работы радара и систем обороны</h2>
          <p class="lead">Схема сверху показывает, в каких секторах работают радар, станция предупреждения об облучении и датчики обнаружения пуска ракет.</p>
        </div>
        <CoverageDiagram data={cov} />
      </div>
    </section>
  )}

  {defense && (
    <section class="section" id="defense">
      <div class="wrap">
        <div class="section-head">
          <h2>Системы защиты</h2>
          <p class="lead">Состав по открытым источникам для основных серийных вариантов. Анимации показывают общий принцип, <a href="/defense/">больше на странице о защите</a>.</p>
        </div>
        <ul class="defense-list">
          {defense.map((d) => (<li><div><strong>{d.name}</strong><div class="kind">{kindName[d.kind]}</div></div><span>{d.note}</span></li>))}
        </ul>
        <DefenseDemo only={defenseScenes} initial={defenseScenes[0]} />
      </div>
    </section>
  )}

  {radar && (
    <section class="section" id="radar">
      <div class="wrap">
        <div class="section-head">
          <h2>Радиолокатор</h2>
          <p class="lead">{radar.name}. Антенна: {radar.antenna === 'aesa' ? 'АФАР (электронное сканирование)' : 'механическое сканирование'}. Анимации показывают общий принцип режимов, <a href="/radar/">подробнее на странице о радарах</a>.</p>
        </div>
        <RadarDemo aesa={radar.antenna === 'aesa'} />
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Другие в группе</h2>
      </div>
      {others.length > 0 ? (
        <div class="cards">
          {others.map((other) => (
            <a class="card" href={itemUrl(other)} style={`--c:var(--era-${eraOf(other.year).id})`}>
              <span class="stripe"></span>
              <h3>{other.name}</h3>
              <span class="meta num">{other.year} · {other.country}</span>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty">Других моделей в этой группе пока нет.</p>
      )}
      <p class="notice" style="margin-top: 32px;">
        Значения округлены и приведены по открытым источникам. Подробности: <a href="/sources/">источники и методика</a>.
        {item.wiki && <>Страница модели в Википедии: <a href={`https://en.wikipedia.org/wiki/${item.wiki}`} rel="noopener" target="_blank">открыть</a>.</>}
      </p>
    </div>
  </section>
</Base>
