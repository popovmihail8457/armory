---
import Base from '../../../../layouts/Base.astro';
import { eras, domains } from '../../../../data/taxonomy';
import { groupsOfDomain, itemsIn, groupUrl } from '../../../../lib/data';

export function getStaticPaths() {
  return eras.flatMap((era) =>
    domains
      .filter((domain) => groupsOfDomain(domain.id).some((g) => itemsIn(era.id, g.id).length > 0))
      .map((domain) => ({ params: { era: era.id, domain: domain.id }, props: { era, domain } })),
  );
}

const { era, domain } = Astro.props;
const list = groupsOfDomain(domain.id);
---
<Base title={`${domain.name}: ${era.name}`} era={era.id} domain={domain.id} description={`${domain.name}, ${era.name}. ${domain.lead}`}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Навигация">
      <a href="/">Главная</a><span>/</span><a href={`/periods/${era.id}/`}>{era.name}</a><span>/</span><span>{domain.name}</span>
    </nav>
  </div>
  <section class="section" style={`--c:var(--era-${era.id})`}>
    <div class="wrap">
      <div class="section-head">
        <span class="stripe"></span>
        <span class="eyebrow">{era.name}</span>
        <h1>{domain.name}</h1>
        <p class="lead">{domain.lead}</p>
      </div>
      <div class="cards">
        {list.map((group) => {
          const items = itemsIn(era.id, group.id);
          const body = (
            <>
              <h3>{group.name}</h3>
              <span class="meta num">{items.length} {items.length === 1 ? 'модель' : 'моделей'}</span>
              <span class="desc">{items.length ? items.map((i) => i.name).join(', ') : 'В этом периоде записей пока нет.'}</span>
            </>
          );
          return items.length > 0
            ? <a class="card" href={groupUrl(era.id, group)}>{body}</a>
            : <div class="card disabled">{body}</div>;
        })}
      </div>
    </div>
  </section>
</Base>
