---
import Base from '../../layouts/Base.astro';
import WeaponBars from '../../components/WeaponBars.astro';
import { weaponCategories, weapons, weaponsOfCategory, weaponUrl, classesOf } from '../../lib/weapons';
import { weaponGroups } from '../../data/weapons/taxonomy';
import { weaponMetrics } from '../../data/weapons/taxonomy';
import { formatNumber } from '../../lib/data';
import { bgForPage } from '../../lib/bg';
const pagePhoto = bgForPage('weapons');
---
<Base title="Вооружение" photoUrl={pagePhoto} noPhoto={!pagePhoto} description="Каталог вооружения: ракеты, пушки, торпеды и управляемые бомбы с характеристиками, принципом работы и модификациями." noPhoto>
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Каталог</span>
        <h1>Вооружение</h1>
        <p class="lead">{weapons.length} образцов в {weaponCategories.length} категориях. У каждого образца своя страница: характеристики, принцип работы, устройство, модификации и носители.</p>
      </div>
      {(Object.keys(weaponGroups) as (keyof typeof weaponGroups)[]).map((group) => (
        <div style="margin-top: 28px;">
          <h3 class="eyebrow" style="margin-bottom: 12px;">{weaponGroups[group]}</h3>
          <div class="chips">
            {weaponCategories.filter((c) => c.group === group).map((category) => (
              <a class="chip" href={`#${category.id}`}>{category.name} <span class="num">{weaponsOfCategory(category.id).length}</span></a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  {weaponCategories.map((category) => {
    const items = weaponsOfCategory(category.id);
    const key = category.metrics[0];
    return (
      <section class="section lazy-section" id={category.id}>
        <div class="wrap">
          <div class="section-head">
            <h2>{category.name}</h2>
            <p class="lead">{category.lead}</p>
          </div>
          <div class="cards" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr)); margin-bottom: 32px;">
            <WeaponBars items={items} metric={key} />
            {category.metrics[1] && <WeaponBars items={items} metric={category.metrics[1]} />}
          </div>
          <div class="cards">
            {items.map((weapon) => (
              <a class="card" href={weaponUrl(weapon)}>
                <span class="meta num">{weapon.year} · {weapon.country}</span>
                <h3>{weapon.name}</h3>
                {classesOf(weapon).length > 1 && <span class="meta">{classesOf(weapon).map((c) => c.name).join(' · ')}</span>}
                <span class="desc">{weapon.type}</span>
                {weapon.specs[key] !== undefined && (
                  <span class="meta num">{weaponMetrics[key].label}: ≈{formatNumber(weapon.specs[key] as number)} {weaponMetrics[key].unit}</span>
                )}
              </a>
            ))}
          </div>
        </div>
      </section>
    );
  })}
</Base>
