---
import '../styles/global.css';
import { eras, type EraId } from '../data/taxonomy';
import { bgFor } from '../lib/bg';

interface Props {
  title: string;
  description?: string;
  era?: EraId;
  domain?: string;
  group?: string;
  noPhoto?: boolean;
  photoUrl?: string;
  /** Вид перехода при входе на страницу: пролёт камеры по доменам техники. */
  vt?: 'aviation' | 'fleet' | 'ground' | 'weapon';
  /** Подпись места, которая коротко показывается при входе, например «Ангар · Истребители». */
  place?: string;
  noindex?: boolean;
}

const { title, description = 'Справочник военной техники с 1947 года до наших дней: флот, авиация и наземная техника.', era, domain, group, noPhoto = false, photoUrl, vt, place, noindex = false } = Astro.props;
const photo = photoUrl ?? (noPhoto ? undefined : bgFor(era, domain, group));
const photoMobile = photo?.replace(/\.jpg$/, '-m.jpg');
const activeEra = eras.find((item) => item.id === era);
const eraLabel = activeEra ? `${activeEra.from}–${activeEra.to === 2026 ? 'н. в.' : activeEra.to}` : '';
const pathname = Astro.url.pathname;
const canonical = Astro.site ? new URL(pathname, Astro.site).href : undefined;
const ogImage = photo && Astro.site ? new URL(photo, Astro.site).href : undefined;
const fullTitle = title === 'Арсенал' ? 'Арсенал: справочник военной техники' : `${title} | Арсенал`;
---
<!doctype html>
<html lang="ru" data-vt={vt}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0d1117" />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Арсенал" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {noindex && <meta name="robots" content="noindex" />}
    {photo && <link rel="preload" as="image" href={photoMobile} media="(max-width: 720px)" fetchpriority="high" />}
    {photo && <link rel="preload" as="image" href={photo} media="(min-width: 721px)" fetchpriority="high" />}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <div class="bg" data-era={era ?? 'none'} data-photo={photo ? 'on' : 'off'} aria-hidden="true">
      {photo && <div class="bg-photo" style={`--photo:url('${photo}');--photo-m:url('${photoMobile}')`}></div>}
      <div class="bg-glow"></div>
      <div class="bg-pattern"></div>
      {eraLabel && <div class="bg-year num">{eraLabel}</div>}
    </div>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">Арсенал</a>
        <nav class="nav" aria-label="Периоды">
          {eras.map((era) => (
            <a href={`/periods/${era.id}/`} aria-current={pathname.startsWith(`/periods/${era.id}/`) ? 'page' : undefined}>
              {era.from}–{era.to === 2026 ? 'н. в.' : era.to}{pathname.startsWith(`/periods/${era.id}/`) && <span class="nav-mark"></span>}
            </a>
          ))}
          <a href="/weapons/" aria-current={pathname.startsWith('/weapons') ? 'page' : undefined}>Вооружение{pathname.startsWith('/weapons') && <span class="nav-mark"></span>}</a>
          <a href="/ballistics/" aria-current={pathname.startsWith('/ballistics') ? 'page' : undefined}>Баллистика{pathname.startsWith('/ballistics') && <span class="nav-mark"></span>}</a>
          <a href="/flight/" aria-current={pathname.startsWith('/flight') ? 'page' : undefined}>Полёт ракет{pathname.startsWith('/flight') && <span class="nav-mark"></span>}</a>
          <a href="/radar/" aria-current={pathname.startsWith('/radar') ? 'page' : undefined}>Радар{pathname.startsWith('/radar') && <span class="nav-mark"></span>}</a>
          <a href="/defense/" aria-current={pathname.startsWith('/defense') ? 'page' : undefined}>Защита{pathname.startsWith('/defense') && <span class="nav-mark"></span>}</a>
          <a href="/sources/" aria-current={pathname.startsWith('/sources') ? 'page' : undefined}>О данных{pathname.startsWith('/sources') && <span class="nav-mark"></span>}</a>
        </nav>
      </div>
    </header>
    {place && (
      <div class="arrive" aria-hidden="true" style={era ? `--c:var(--era-${era})` : undefined}>
        <span class="arrive-line"></span>
        <span class="arrive-text num">{place}</span>
      </div>
    )}
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>Арсенал: справочник по открытым источникам</span>
        <a href="/sources/">Источники и методика</a>
      </div>
    </footer>
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let ticking = false;
        const root = document.querySelector('.bg') ?? document.documentElement;
        const update = () => {
          root.style.setProperty('--py', String(window.scrollY));
          ticking = false;
        };
        window.addEventListener('scroll', () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        }, { passive: true });
        update();
      }
      const charts = document.querySelectorAll('[data-reveal]');
      const blocks = document.querySelectorAll('.section, .hero-inner, .site-footer');
      const show = (el) => el.classList.add(el.hasAttribute('data-reveal') ? 'in' : 'in-view');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              show(entry.target);
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08 });
        charts.forEach((el) => observer.observe(el));
        blocks.forEach((el) => observer.observe(el));
      } else {
        charts.forEach(show);
        blocks.forEach(show);
      }
      const tocLinks = [...document.querySelectorAll('.toc a[href^="#"]')];
      if (tocLinks.length > 0 && 'IntersectionObserver' in window) {
        const byId = new Map(tocLinks.map((link) => [link.getAttribute('href').slice(1), link]));
        const glow = document.createElement('span');
        glow.className = 'toc-glow';
        tocLinks[0].parentElement.prepend(glow);
        const mark = (id) => {
          tocLinks.forEach((link) => link.removeAttribute('aria-current'));
          const link = byId.get(id);
          if (!link) return;
          link.setAttribute('aria-current', 'true');
          glow.style.setProperty('--x', link.offsetLeft + 'px');
          glow.style.setProperty('--w', link.offsetWidth + 'px');
          glow.classList.add('on');
          const bar = link.parentElement;
          bar.scrollTo({ left: link.offsetLeft - bar.clientWidth / 2 + link.offsetWidth / 2, behavior: 'smooth' });
        };
        const spy = new IntersectionObserver((entries) => {
          entries.forEach((entry) => { if (entry.isIntersecting) mark(entry.target.id); });
        }, { rootMargin: '-30% 0px -60% 0px' });
        byId.forEach((link, id) => { const target = document.getElementById(id); if (target) spy.observe(target); });
      }
    </script>
  </body>
</html>
