---
import { radarModes, type RadarModeId } from '../data/radar';

interface Props {
  aesa?: boolean;
  initial?: RadarModeId;
}

const { aesa = true, initial = 'search' } = Astro.props;
const modes = radarModes.filter((mode) => aesa || !mode.aesaOnly);
---
<section class="radar" data-radar data-initial={initial}>
  <div class="radar-tabs" role="tablist" aria-label="Режимы радиолокатора">
    {modes.map((mode) => (
      <button type="button" role="tab" class="radar-tab" data-mode={mode.id} aria-selected={mode.id === initial}>
        <span class="num">{mode.short}</span> {mode.name}
      </button>
    ))}
  </div>
  <div class="radar-body">
    <div class="radar-stage">
      <canvas class="radar-canvas" width="720" height="520" role="img" aria-label="Анимация работы радара в выбранном режиме"></canvas>
      <button type="button" class="radar-toggle" aria-pressed="false">Пауза</button>
    </div>
    <div class="radar-info">
      <h3 class="radar-title"></h3>
      <p class="radar-text"></p>
      <dl class="radar-readout">
        <div><dt>Лучи</dt><dd class="r-beams">-</dd></div>
        <div><dt>Цели</dt><dd class="r-targets">-</dd></div>
        <div><dt>Обновление</dt><dd class="r-rate">-</dd></div>
      </dl>
    </div>
  </div>
  <script type="application/json" class="radar-data" set:html={JSON.stringify(modes)} />
</section>

<script>
  type Mode = 'search' | 'tws' | 'stt' | 'sar' | 'aesa';
  interface ModeInfo { id: Mode; name: string; short: string; text: string }
  interface Target { x: number; y: number; vx: number; vy: number; seen: number; trail: { x: number; y: number }[] }

  const SECTOR = (Math.PI / 180) * 60;

  function init(root: HTMLElement) {
    const canvas = root.querySelector<HTMLCanvasElement>('.radar-canvas')!;
    const ctx = canvas.getContext('2d')!;
    const modes = JSON.parse(root.querySelector('.radar-data')!.textContent ?? '[]') as ModeInfo[];
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.radar-tab')];
    const toggle = root.querySelector<HTMLButtonElement>('.radar-toggle')!;
    const css = getComputedStyle(root);
    const beamColor = css.getPropertyValue('--era-modern').trim() || '#c98500';
    const trackColor = css.getPropertyValue('--text').trim() || '#f2f1ec';
    const gridColor = 'rgba(255,255,255,0.14)';
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const W = canvas.width, H = canvas.height;
    const ox = W / 2, oy = H - 36, R = H - 80;
    let mode = (root.dataset.initial as Mode) || 'search';
    let paused = reduce;
    let t = 0;
    let last = performance.now();

    const targets: Target[] = Array.from({ length: 5 }, (_, i) => ({
      x: -0.6 + i * 0.3 + (i % 2) * 0.05, y: 0.35 + ((i * 37) % 50) / 100,
      vx: (i % 2 ? 1 : -1) * 0.012, vy: -0.008 - (i % 3) * 0.004, seen: -10, trail: [],
    }));
    let lockedIndex = 2;
    let ground: ImageData | null = null;
    let sarProgress = 0;

    const polar = (a: number, r: number) => ({ x: ox + Math.sin(a) * r * R, y: oy - Math.cos(a) * r * R });
    const bearingOf = (tg: Target) => Math.atan2(tg.x, tg.y);
    const rangeOf = (tg: Target) => Math.hypot(tg.x, tg.y);

    function drawGrid() {
      ctx.strokeStyle = gridColor; ctx.lineWidth = 1; ctx.fillStyle = 'rgba(255,255,255,0.42)';
      ctx.font = '12px Consolas, monospace';
      for (let i = 1; i <= 4; i++) {
        ctx.beginPath(); ctx.arc(ox, oy, (R * i) / 4, -Math.PI / 2 - SECTOR, -Math.PI / 2 + SECTOR); ctx.stroke();
      }
      for (const a of [-SECTOR, -SECTOR / 2, 0, SECTOR / 2, SECTOR]) {
        const p = polar(a, 1); ctx.beginPath(); ctx.moveTo(ox, oy); ctx.lineTo(p.x, p.y); ctx.stroke();
      }
      ctx.fillText('0°', ox - 8, oy - R - 8); ctx.fillText('-60°', polar(-SECTOR, 1).x - 30, polar(-SECTOR, 1).y - 4); ctx.fillText('+60°', polar(SECTOR, 1).x + 4, polar(SECTOR, 1).y - 4);
      ctx.beginPath(); ctx.moveTo(ox - 8, oy + 8); ctx.lineTo(ox, oy - 8); ctx.lineTo(ox + 8, oy + 8); ctx.closePath(); ctx.fillStyle = trackColor; ctx.fill();
    }

    function beam(angle: number, width: number, alpha: number) {
      ctx.save();
      ctx.fillStyle = beamColor; ctx.globalAlpha = alpha;
      ctx.beginPath(); ctx.moveTo(ox, oy);
      ctx.arc(ox, oy, R, -Math.PI / 2 + angle - width, -Math.PI / 2 + angle + width); ctx.closePath(); ctx.fill();
      ctx.restore();
    }

    function stepTargets(dt: number) {
      for (const tg of targets) {
        tg.x += tg.vx * dt; tg.y += tg.vy * dt;
        if (Math.abs(bearingOf(tg)) > SECTOR * 0.95 || tg.y < 0.12 || rangeOf(tg) > 0.98) {
          tg.x = (Math.random() - 0.5) * 0.9; tg.y = 0.5 + Math.random() * 0.4; tg.trail = [];
        }
      }
    }

    function blip(tg: Target, alpha: number, box = false) {
      const p = polar(bearingOf(tg), rangeOf(tg));
      ctx.save(); ctx.globalAlpha = alpha; ctx.fillStyle = trackColor;
      ctx.beginPath(); ctx.arc(p.x, p.y, 4, 0, Math.PI * 2); ctx.fill();
      if (box) { ctx.strokeStyle = trackColor; ctx.strokeRect(p.x - 10, p.y - 10, 20, 20); }
      ctx.restore();
      return p;
    }

    function drawSweepModes(dt: number) {
      const period = mode === 'aesa' ? 1.4 : 3.6;
      const phase = (t % period) / period;
      const tri = phase < 0.5 ? phase * 2 : 2 - phase * 2;
      const angle = (tri * 2 - 1) * SECTOR;
      const barRow = Math.floor((t / period) * 0.5) % 4;
      const stt = mode === 'stt';
      const aesa = mode === 'aesa';

      const aim = stt ? bearingOf(targets[lockedIndex]) : angle;
      beam(aim, stt ? 0.025 : 0.05, stt ? 0.55 : 0.28);
      if (aesa) {
        for (let k = 0; k < 3; k++) {
          const a = Math.sin(t * (4 + k * 1.7) + k * 2) * SECTOR * 0.9;
          beam(a, 0.022, 0.4);
        }
        beam(bearingOf(targets[lockedIndex]), 0.02, 0.6);
      }

      for (let i = 0; i < targets.length; i++) {
        const tg = targets[i];
        const hit = stt ? i === lockedIndex : Math.abs(bearingOf(tg) - angle) < 0.07 || (aesa && Math.random() < 0.02);
        if (hit) {
          tg.seen = t;
          if (mode === 'tws' || aesa || stt) {
            const last = tg.trail[tg.trail.length - 1];
            if (!last || Math.hypot(last.x - tg.x, last.y - tg.y) > 0.02 || stt) tg.trail.push({ x: tg.x, y: tg.y });
            if (tg.trail.length > 8) tg.trail.shift();
          }
        }
        const age = t - tg.seen;
        const fade = mode === 'search' ? Math.max(0, 1 - age / (period * 0.9)) : Math.max(0.25, 1 - age / (period * 1.6));
        if (mode === 'search' && age > period) continue;
        const tracked = mode === 'tws' || aesa || stt;
        if (tracked && age > period * 3) continue;
        const p = blip(tg, tracked ? 1 : fade, tracked && (mode !== 'stt' || i === lockedIndex));
        if (tracked && tg.trail.length > 1) {
          ctx.save(); ctx.strokeStyle = trackColor; ctx.globalAlpha = 0.45; ctx.beginPath();
          tg.trail.forEach((pt, idx) => {
            const q = polar(Math.atan2(pt.x, pt.y), Math.hypot(pt.x, pt.y));
            idx === 0 ? ctx.moveTo(q.x, q.y) : ctx.lineTo(q.x, q.y);
          });
          ctx.stroke();
          const v = polar(Math.atan2(tg.x + tg.vx * 90, tg.y + tg.vy * 90), Math.hypot(tg.x + tg.vx * 90, tg.y + tg.vy * 90));
          ctx.setLineDash([4, 4]); ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(v.x, v.y); ctx.stroke(); ctx.restore();
          ctx.fillStyle = trackColor; ctx.font = '12px Consolas, monospace'; ctx.fillText(`T${i + 1}`, p.x + 12, p.y - 10);
        }
      }
      ctx.fillStyle = 'rgba(255,255,255,0.5)'; ctx.font = '12px Consolas, monospace';
      if (mode === 'search' || mode === 'tws') ctx.fillText(`полоса ${barRow + 1} из 4`, 16, 24);
      if (stt) {
        const tg = targets[lockedIndex];
        ctx.fillText(`захват T${lockedIndex + 1}: дальность ${(rangeOf(tg) * 100).toFixed(0)} усл. ед.`, 16, 24);
      }
      void dt;
    }

    function buildGround() {
      const off = document.createElement('canvas'); off.width = W; off.height = H;
      const g = off.getContext('2d')!;
      g.fillStyle = '#20231f'; g.fillRect(0, 0, W, H);
      for (let i = 0; i < 90; i++) {
        const x = Math.random() * W, y = Math.random() * H, w = 6 + Math.random() * 40, h = 6 + Math.random() * 40;
        g.fillStyle = `rgba(255,255,255,${0.08 + Math.random() * 0.25})`; g.fillRect(x, y, w, h);
      }
      g.strokeStyle = 'rgba(255,255,255,0.35)'; g.lineWidth = 3;
      g.beginPath(); g.moveTo(0, H * 0.7); g.bezierCurveTo(W * 0.3, H * 0.4, W * 0.6, H * 0.9, W, H * 0.3); g.stroke();
      ground = g.getImageData(0, 0, W, H);
    }

    function drawSar(dt: number) {
      if (!ground) buildGround();
      sarProgress = (sarProgress + dt * 90) % (H + 140);
      const rows = Math.floor(sarProgress);
      const img = ctx.createImageData(W, H);
      for (let y = 0; y < Math.min(rows, H); y++) {
        const sy = H - 1 - y;
        for (let x = 0; x < W; x++) {
          const i = (sy * W + x) * 4, j = (y * W + x) * 4;
          img.data[i] = ground!.data[j]; img.data[i + 1] = ground!.data[j + 1]; img.data[i + 2] = ground!.data[j + 2]; img.data[i + 3] = 255;
        }
      }
      ctx.putImageData(img, 0, 0);
      const edge = H - Math.min(sarProgress, H);
      ctx.save(); ctx.strokeStyle = beamColor; ctx.lineWidth = 2; ctx.beginPath(); ctx.moveTo(0, edge); ctx.lineTo(W, edge); ctx.stroke();
      ctx.fillStyle = beamColor; ctx.globalAlpha = 0.18; ctx.fillRect(0, edge - 22, W, 22); ctx.restore();
      ctx.save(); ctx.fillStyle = trackColor; ctx.translate(ox, H - 28); ctx.beginPath(); ctx.moveTo(0, -12); ctx.lineTo(10, 10); ctx.lineTo(0, 5); ctx.lineTo(-10, 10); ctx.closePath(); ctx.fill(); ctx.restore();
      ctx.fillStyle = 'rgba(255,255,255,0.55)'; ctx.font = '12px Consolas, monospace';
      ctx.fillText('самолёт летит вверх, изображение собирается построчно', 16, 24);
    }

    function readout() {
      const beams = mode === 'aesa' ? 'до 4 одновременно' : mode === 'stt' ? '1 узкий' : mode === 'sar' ? 'направлен на землю' : 'сканирующий';
      const rate = mode === 'stt' ? 'много раз в секунду' : mode === 'aesa' ? 'доли секунды' : mode === 'sar' ? 'по мере полёта' : 'раз в несколько секунд';
      const count = mode === 'sar' ? 'неподвижные объекты' : mode === 'stt' ? '1 в захвате' : `${targets.length} в секторе`;
      root.querySelector('.r-beams')!.textContent = beams;
      root.querySelector('.r-targets')!.textContent = count;
      root.querySelector('.r-rate')!.textContent = rate;
    }

    function setMode(id: Mode) {
      mode = id; t = 0; sarProgress = 0;
      targets.forEach((tg) => { tg.seen = -10; tg.trail = []; });
      tabs.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.mode === id)));
      const info = modes.find((m) => m.id === id)!;
      root.querySelector('.radar-title')!.textContent = `${info.short}: ${info.name}`;
      root.querySelector('.radar-text')!.textContent = info.text;
      readout();
      if (paused) frame(0);
    }

    function frame(dt: number) {
      ctx.clearRect(0, 0, W, H);
      ctx.fillStyle = '#1a1a19'; ctx.fillRect(0, 0, W, H);
      if (mode === 'sar') { drawSar(dt); return; }
      drawGrid();
      stepTargets(dt);
      drawSweepModes(dt);
    }

    function loop(now: number) {
      const dt = Math.min(0.05, (now - last) / 1000); last = now;
      if (!paused) { t += dt; frame(dt); }
      requestAnimationFrame(loop);
    }

    tabs.forEach((b) => b.addEventListener('click', () => setMode(b.dataset.mode as Mode)));
    toggle.textContent = paused ? 'Запустить' : 'Пауза';
    toggle.setAttribute('aria-pressed', String(paused));
    toggle.addEventListener('click', () => {
      paused = !paused;
      toggle.textContent = paused ? 'Запустить' : 'Пауза';
      toggle.setAttribute('aria-pressed', String(paused));
    });
    setMode(mode);
    if (paused) { t = 4; frame(0.016); }
    requestAnimationFrame(loop);
  }

  document.querySelectorAll<HTMLElement>('[data-radar]').forEach(init);
</script>
