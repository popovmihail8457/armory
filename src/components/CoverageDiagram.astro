---
import type { AircraftCoverage, ArcSystem } from '../data/coverage';

interface Props {
  data: AircraftCoverage;
}

const { data } = Astro.props;
const CX = 240, CY = 235;
const JET = [[0, -14], [3, -4], [16, 6], [16, 9], [3, 5], [2, 12], [7, 15], [7, 17], [0, 15], [-7, 17], [-7, 15], [-2, 12], [-3, 5], [-16, 9], [-16, 6], [-3, -4]];
const jetPath = JET.map(([x, y], i) => `${i ? 'L' : 'M'}${(CX + x * 2.1).toFixed(1)} ${(CY + y * 2.1).toFixed(1)}`).join(' ') + ' Z';

const rad = (deg: number) => (deg * Math.PI) / 180;
const pt = (angle: number, r: number) => `${(CX + Math.sin(rad(angle)) * r).toFixed(1)} ${(CY - Math.cos(rad(angle)) * r).toFixed(1)}`;
const wedge = (half: number, r: number) =>
  `M${CX} ${CY} L${pt(-half, r)} A${r} ${r} 0 ${half > 90 ? 1 : 0} 1 ${pt(half, r)} Z`;
const arc = (half: number, r: number) => `M${pt(-half, r)} A${r} ${r} 0 ${half > 90 ? 1 : 0} 1 ${pt(half, r)}`;
const label = (s: ArcSystem) => (s.half >= 180 ? '360°' : `±${s.half}° (сектор ${s.half * 2}°)`);

const rows = [
  data.radar && { key: 'radar', title: 'Радар', system: data.radar, color: 'var(--era-modern)' },
  data.rwr && { key: 'rwr', title: 'Предупреждение об облучении', system: data.rwr, color: 'var(--era-post)' },
  data.maws && { key: 'maws', title: 'Обнаружение пуска ракет', system: data.maws, color: 'var(--era-early)' },
].filter(Boolean) as { key: string; title: string; system: ArcSystem; color: string }[];
---
{data.status || rows.length === 0 ? (
  <p class="notice">{data.note}</p>
) : (
  <div class="cov" data-reveal>
    <svg viewBox="0 0 480 470" role="img" aria-label="Схема углов обзора бортовых систем, вид сверху, нос направлен вверх">
      {[60, 120, 180].map((r) => <circle class="cov-grid" cx={CX} cy={CY} r={r} />)}
      {[-60, 0, 60].map((a) => <line class="cov-grid" x1={CX} y1={CY} x2={pt(a, 200).split(' ')[0]} y2={pt(a, 200).split(' ')[1]} />)}
      <text class="cov-tick" x={CX} y={CY - 208} text-anchor="middle">0°</text>
      <text class="cov-tick" x={CX + Math.sin(rad(60)) * 206} y={CY - Math.cos(rad(60)) * 206} text-anchor="start">+60°</text>
      <text class="cov-tick" x={CX - Math.sin(rad(60)) * 206} y={CY - Math.cos(rad(60)) * 206} text-anchor="end">-60°</text>
      {data.maws && (
        <g class="cov-layer" style="--d:0.4s">
          <circle cx={CX} cy={CY} r={110} fill="var(--era-early)" fill-opacity="0.07" stroke="var(--era-early)" stroke-width="2" stroke-dasharray="2 5" />
        </g>
      )}
      {data.rwr && (
        <g class="cov-layer" style="--d:0.2s">
          {data.rwr.half >= 180
            ? <circle cx={CX} cy={CY} r={150} fill="none" stroke="var(--era-post)" stroke-width="3" stroke-dasharray="8 5" />
            : <path d={arc(data.rwr.half, 150)} fill="none" stroke="var(--era-post)" stroke-width="3" stroke-dasharray="8 5" />}
        </g>
      )}
      {data.radar && (
        <g class="cov-layer" style="--d:0s">
          {data.radar.half >= 180
            ? <circle cx={CX} cy={CY} r={190} fill="var(--era-modern)" fill-opacity="0.12" stroke="var(--era-modern)" stroke-width="2" />
            : <path d={wedge(data.radar.half, 190)} fill="var(--era-modern)" fill-opacity="0.22" stroke="var(--era-modern)" stroke-width="2" />}
        </g>
      )}
      <path d={jetPath} fill="var(--text)" />
    </svg>
    <ul class="cov-legend">
      {rows.map((row) => (
        <li style={`--c:${row.color}`}>
          <span class="cov-chip"></span>
          <div>
            <strong>{row.title}</strong>
            <span class="cov-angle num">{label(row.system)}</span>
            <p>{row.system.name}{row.system.note ? `. ${row.system.note}` : ''}</p>
          </div>
        </li>
      ))}
      <li class="cov-foot">Углы приведены по открытым данным, значения ориентировочные. Нос самолёта направлен вверх.</li>
    </ul>
  </div>
)}
