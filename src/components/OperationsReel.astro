---
import type { Operation } from '../data/operations';
import type { VideoClip } from '../data/videos';

interface Props {
  ops: Operation[];
  clips: VideoClip[];
}

const { ops, clips } = Astro.props;
---
<div class="reel" data-reel data-clips={JSON.stringify(clips.map((c) => c.src))}>
  <div class="reel-stage" aria-hidden="true">
    {clips.length > 0 && <video class="reel-video" muted loop playsinline preload="none" tabindex="-1"></video>}
    <div class="reel-shade"></div>
  </div>
  <div class="reel-cards">
    {ops.map((op, i) => (
      <article class="reel-card" data-video={op.video ?? ''}>
        <div class="reel-box">
          <span class="chapter-n num">{String(i + 1).padStart(2, '0')} · {op.years}</span>
          <h3>{op.name}</h3>
          <p>{op.text}</p>
        </div>
      </article>
    ))}
  </div>
  {clips.length > 0 && (
    <p class="reel-credit">
      Видео: {clips.map((c, i) => (<><a href={c.page} rel="noopener" target="_blank">{c.title}</a> ({c.author}, {c.license}){i < clips.length - 1 ? '; ' : ''}</>))}.
    </p>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-reel]').forEach((root) => {
    const video = root.querySelector<HTMLVideoElement>('.reel-video');
    const clips = JSON.parse(root.dataset.clips ?? '[]') as string[];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const small = window.matchMedia('(max-width: 720px)').matches;
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
    if (!video || clips.length === 0 || reduce || small || saveData) return;
    let visible = false;
    let currentSrc = '';
    /** Облегчённая версия ролика на Commons (480p): загружается в разы быстрее оригинала. */
    const light = (src: string) => {
      const [file, fragment] = src.split('#');
      const match = file.match(/^(https:\/\/upload\.wikimedia\.org\/wikipedia\/commons)\/(.+\/([^/]+))$/);
      if (!match) return undefined;
      return `${match[1]}/transcoded/${match[2]}/${match[3]}.480p.vp9.webm${fragment ? '#' + fragment : ''}`;
    };
    const show = (index: number) => {
      const src = clips[index];
      if (!src || src === currentSrc) return;
      currentSrc = src;
      video.classList.remove('ready');
      const sources = [light(src), src].filter((url): url is string => Boolean(url)).map((url) => {
        const source = document.createElement('source');
        source.src = url;
        return source;
      });
      video.replaceChildren(...sources);
      video.load();
      if (visible) video.play().catch(() => {});
    };
    video.addEventListener('playing', () => video.classList.add('ready'));
    /* Загрузка начинается заранее, когда блок только приближается к экрану, чтобы ролик шёл без задержки. */
    const warm = new IntersectionObserver((entries) => {
      if (!entries[0].isIntersecting) return;
      video.preload = 'auto';
      show(0);
      warm.disconnect();
    }, { rootMargin: '200% 0px' });
    warm.observe(root);
    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      if (visible) { if (!currentSrc) show(0); video.play().catch(() => {}); } else video.pause();
    }, { threshold: 0.01 }).observe(root);
    const cards = root.querySelectorAll<HTMLElement>('.reel-card');
    const cardObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const raw = (entry.target as HTMLElement).dataset.video;
        if (entry.isIntersecting && raw) show(Number(raw));
      });
    }, { threshold: 0.5 });
    cards.forEach((card) => cardObserver.observe(card));
  });
</script>
