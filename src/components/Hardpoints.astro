---
import type { Equipment } from '../data/equipment';
import type { WeaponData } from '../data/weapons/types';
import { hardpointSpecs, layoutOfGroup, TYPICAL_EXTERNAL, stationsOf, roleName, roleAccepts, loadouts, silhouettes } from '../data/hardpoints';
import { weaponUrl } from '../lib/weapons';

interface Props {
  item: Equipment;
  weapons: WeaponData[];
}

const { item, weapons } = Astro.props;
const spec = hardpointSpecs[item.id];
const layout = spec?.layout ?? layoutOfGroup[item.group] ?? 'fighter';
const known = spec?.external !== undefined || spec?.internal !== undefined;
const external = spec?.external ?? (known ? 0 : TYPICAL_EXTERNAL[layout]);
const internal = spec?.internal ?? 0;
const stations = stationsOf(layout, external, internal);
const guns = weapons.filter((weapon) => weapon.category === 'aircraft-guns');
const stores = weapons.filter((weapon) => weapon.category !== 'aircraft-guns' && weapon.category !== 'mg');
const rows = stations.map((station) => ({
  station,
  fits: stores.filter((weapon) => roleAccepts[station.role].includes(weapon.category)),
}));
const available = loadouts.filter((load) => rows.some((row) => row.fits.some((weapon) => load.categories.includes(weapon.category))));
const total = external + internal;
const bays = stations.filter((station) => station.internal);
const bayBox = bays.length > 0 ? {
  x: Math.min(...bays.map((s) => s.x)) - 5,
  y: Math.min(...bays.map((s) => s.y)) - 5,
  w: Math.max(...bays.map((s) => s.x)) - Math.min(...bays.map((s) => s.x)) + 10,
  h: Math.max(...bays.map((s) => s.y)) - Math.min(...bays.map((s) => s.y)) + 10,
} : undefined;
---
{stations.length > 0 && stores.length > 0 && (
  <div class="hp" data-hp>
    <div class="hp-presets" role="group" aria-label="Набор нагрузки">
      <button type="button" class="ball-btn" data-load="all" aria-pressed="true">Все варианты</button>
      {available.map((load) => (
        <button type="button" class="ball-btn" data-load={load.id} data-cats={load.categories.join(',')} aria-pressed="false" title={load.text}>{load.name}</button>
      ))}
    </div>
    <div class="hp-body">
      <figure class="hp-fig">
        <svg viewBox="0 0 100 100" role="img" aria-label={`Схема точек подвески: ${item.name}, вид сверху`}>
          <path class="hp-body-shape" d={silhouettes[layout]} />
          {layout === 'heli' && <circle class="hp-rotor" cx="50" cy="40" r="36" />}
          {bayBox && <rect class="hp-bay" x={bayBox.x} y={bayBox.y} width={bayBox.w} height={bayBox.h} rx="1.5" />}
          {rows.map(({ station }) => (
            <g class={`hp-st${station.internal ? ' hp-in' : ''}`} data-s={station.id} transform={`translate(${station.x} ${station.y})`} tabindex="0" role="button" aria-label={`Точка ${station.n}: ${roleName[station.role]}`}>
              <circle class="hp-hit" r="5" />
              <circle class="hp-dot" r="3.4" />
              <text text-anchor="middle" dy="1.3">{station.n}</text>
            </g>
          ))}
        </svg>
        <figcaption>
          {known ? `Точек подвески: внешних ${external}, внутренних ${internal}.` : `Точное число точек подвески в открытых данных не уточнено. Показана типовая схема класса: ${external} внешних точек.`}
          {spec?.note ? ' ' + spec.note : ''} Схема условная: положение точек показано приблизительно.
        </figcaption>
      </figure>
      <ol class="hp-list">
        {rows.map(({ station, fits }) => (
          <li data-s={station.id} tabindex="0">
            <span class="amap-n num">{station.n}</span>
            <div>
              <strong>{roleName[station.role]}</strong>
              <span class="amap-kind">{station.side === 'l' ? 'левая сторона' : station.side === 'r' ? 'правая сторона' : 'по оси'}{station.internal ? ' · не демаскирует самолёт' : ''}</span>
              <div class="chips hp-chips">
                {fits.length === 0 && <span class="hp-empty">нет подходящих образцов в справочнике</span>}
                {fits.map((weapon) => <a class="chip" href={weaponUrl(weapon)} data-cat={weapon.category}>{weapon.name}</a>)}
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
    {guns.length > 0 && (
      <p class="hp-gun"><span class="eyebrow">Встроенная пушка</span>{guns.map((gun) => <a href={weaponUrl(gun)}>{gun.name}</a>).reduce((acc: any[], link, i) => (i ? [...acc, ', ', link] : [link]), [])}</p>
    )}
    <p class="notice">Всего точек: {total}. Совместимость определяется классом оружия и типом точки, действительный состав нагрузки зависит от версии самолёта и задачи.</p>
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-hp]').forEach((root) => {
    const set = (id: string | null, on: boolean) => {
      if (!id) return;
      root.querySelectorAll<HTMLElement | SVGElement>(`[data-s="${id}"]`).forEach((el) => el.classList.toggle('active', on));
    };
    root.querySelectorAll<HTMLElement | SVGElement>('[data-s]').forEach((el) => {
      el.addEventListener('mouseenter', () => set(el.getAttribute('data-s'), true));
      el.addEventListener('mouseleave', () => set(el.getAttribute('data-s'), false));
      el.addEventListener('focus', () => set(el.getAttribute('data-s'), true));
      el.addEventListener('blur', () => set(el.getAttribute('data-s'), false));
    });
    const presets = [...root.querySelectorAll<HTMLButtonElement>('[data-load]')];
    presets.forEach((button) => button.addEventListener('click', () => {
      presets.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
      const cats = (button.dataset.cats ?? '').split(',').filter(Boolean);
      const all = button.dataset.load === 'all';
      root.querySelectorAll<HTMLElement>('.hp-list li').forEach((li) => {
        const chips = [...li.querySelectorAll<HTMLElement>('.chip')];
        let shown = 0;
        chips.forEach((chip) => { const on = all || cats.includes(chip.dataset.cat ?? ''); chip.hidden = !on; if (on) shown += 1; });
        const dim = !all && shown === 0;
        li.classList.toggle('dim', dim);
        root.querySelectorAll<SVGElement>(`.hp-st[data-s="${li.dataset.s}"]`).forEach((st) => st.classList.toggle('dim', dim));
      });
    }));
  });
</script>
