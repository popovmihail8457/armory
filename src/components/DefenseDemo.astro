---
import { defenseScenes, type SceneId } from '../data/defense';

interface Props {
  initial?: SceneId;
  only?: SceneId[];
}

const { initial = 'rwr', only } = Astro.props;
const scenes = only ? defenseScenes.filter((scene) => only.includes(scene.id)) : defenseScenes;
const start = scenes.some((scene) => scene.id === initial) ? initial : scenes[0].id;
---
<section class="radar defense" data-defense data-initial={start}>
  <div class="radar-tabs" role="tablist" aria-label="Системы защиты">
    {scenes.map((scene) => (
      <button type="button" role="tab" class="radar-tab" data-scene={scene.id} aria-selected={scene.id === start}>
        <span class="num">{scene.short}</span> {scene.name}
      </button>
    ))}
  </div>
  <div class="radar-body">
    <div class="radar-stage">
      <canvas class="radar-canvas" width="720" height="520" role="img" aria-label="Анимация работы системы защиты"></canvas>
      <button type="button" class="radar-toggle" aria-pressed="false">Пауза</button>
    </div>
    <div class="radar-info">
      <h3 class="radar-title"></h3>
      <p class="radar-text"></p>
      <dl class="radar-readout">
        <div><dt>Принцип</dt><dd class="d-1">-</dd></div>
        <div><dt>Задача</dt><dd class="d-2">-</dd></div>
        <div><dt>Особенность</dt><dd class="d-3">-</dd></div>
      </dl>
    </div>
  </div>
  <script type="application/json" class="defense-data" set:html={JSON.stringify(scenes)} />
</section>

<script>
  type SceneId = 'rwr' | 'dass' | 'flare' | 'chaff' | 'ew' | 'aps' | 'ship';
  interface SceneInfo { id: SceneId; name: string; short: string; text: string; readout: [string, string, string] }
  type Ctx = CanvasRenderingContext2D;

  const W = 720, H = 520;
  const TAU = Math.PI * 2;
  const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
  const wrap = (a: number) => Math.atan2(Math.sin(a), Math.cos(a));
  const mix = (a: number, b: number, k: number) => a + (b - a) * k;

  function init(root: HTMLElement) {
    const canvas = root.querySelector<HTMLCanvasElement>('.radar-canvas')!;
    const ctx = canvas.getContext('2d')!;
    const scenes = JSON.parse(root.querySelector('.defense-data')!.textContent ?? '[]') as SceneInfo[];
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.radar-tab')];
    const toggle = root.querySelector<HTMLButtonElement>('.radar-toggle')!;
    const css = getComputedStyle(root);
    const accent = css.getPropertyValue('--era-modern').trim() || '#c98500';
    const blue = css.getPropertyValue('--era-early').trim() || '#3987e5';
    const ink = css.getPropertyValue('--text').trim() || '#f2f1ec';
    const dim = 'rgba(255,255,255,0.14)';
    const faint = 'rgba(255,255,255,0.5)';
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let current: SceneId = (root.dataset.initial as SceneId) || 'rwr';
    let paused = reduce;
    let t = 0;
    let last = performance.now();

    const text = (s: string, x: number, y: number, color = faint, size = 13, align: CanvasTextAlign = 'left') => {
      ctx.fillStyle = color; ctx.font = `${size}px Consolas, monospace`; ctx.textAlign = align; ctx.fillText(s, x, y);
    };
    const line = (x1: number, y1: number, x2: number, y2: number, color = dim, w = 1, alpha = 1, dash: number[] = []) => {
      ctx.save(); ctx.strokeStyle = color; ctx.lineWidth = w; ctx.globalAlpha = alpha; ctx.setLineDash(dash);
      ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke(); ctx.restore();
    };
    const ring = (x: number, y: number, r: number, color = dim, w = 1, alpha = 1, dash: number[] = []) => {
      ctx.save(); ctx.strokeStyle = color; ctx.lineWidth = w; ctx.globalAlpha = alpha; ctx.setLineDash(dash);
      ctx.beginPath(); ctx.arc(x, y, Math.max(0.1, r), 0, TAU); ctx.stroke(); ctx.restore();
    };
    const dot = (x: number, y: number, r: number, color: string, alpha = 1) => {
      ctx.save(); ctx.fillStyle = color; ctx.globalAlpha = alpha; ctx.beginPath(); ctx.arc(x, y, Math.max(0.1, r), 0, TAU); ctx.fill(); ctx.restore();
    };
    const poly = (pts: number[][], x: number, y: number, a: number, s: number, fill: string, stroke?: string) => {
      ctx.save(); ctx.translate(x, y); ctx.rotate(a); ctx.scale(s, s);
      ctx.beginPath(); pts.forEach(([px, py], i) => (i ? ctx.lineTo(px, py) : ctx.moveTo(px, py))); ctx.closePath();
      ctx.fillStyle = fill; ctx.fill(); if (stroke) { ctx.strokeStyle = stroke; ctx.lineWidth = 1 / s; ctx.stroke(); } ctx.restore();
    };
    const JET = [[0, -14], [3, -4], [16, 6], [16, 9], [3, 5], [2, 12], [7, 15], [7, 17], [0, 15], [-7, 17], [-7, 15], [-2, 12], [-3, 5], [-16, 9], [-16, 6], [-3, -4]];
    const SHIP = [[0, -34], [8, -22], [9, 18], [6, 30], [-6, 30], [-9, 18], [-8, -22]];
    const jet = (x: number, y: number, a: number, s = 1.4, color = ink) => poly(JET, x, y, a, s, color);
    const ship = (x: number, y: number, a = 0, s = 1.3) => poly(SHIP, x, y, a, s, '#8a8a82');
    const tank = (x: number, y: number, a = 0) => {
      ctx.save(); ctx.translate(x, y); ctx.rotate(a);
      ctx.fillStyle = '#8a8a82'; ctx.fillRect(-13, -20, 26, 40);
      ctx.fillStyle = '#6f6f68'; ctx.fillRect(-16, -20, 4, 40); ctx.fillRect(12, -20, 4, 40);
      ctx.fillStyle = '#a2a299'; ctx.beginPath(); ctx.arc(0, 2, 10, 0, TAU); ctx.fill();
      ctx.fillStyle = '#a2a299'; ctx.fillRect(-2, -26, 4, 18); ctx.restore();
    };
    const missile = (x: number, y: number, a: number, color = ink, flame = true) => {
      ctx.save(); ctx.translate(x, y); ctx.rotate(a);
      ctx.fillStyle = color; ctx.fillRect(-2, -9, 4, 18);
      if (flame) { ctx.fillStyle = accent; ctx.beginPath(); ctx.moveTo(-2, 9); ctx.lineTo(0, 9 + 10 + Math.random() * 5); ctx.lineTo(2, 9); ctx.fill(); }
      ctx.restore();
    };
    const burst = (x: number, y: number, k: number, color = accent) => {
      if (k <= 0 || k >= 1) return;
      ring(x, y, 6 + k * 34, color, 2, 1 - k);
      for (let i = 0; i < 10; i++) {
        const a = (i / 10) * TAU + 0.3;
        dot(x + Math.cos(a) * k * 36, y + Math.sin(a) * k * 36, 2, color, 1 - k);
      }
    };
    const caption = (s: string, y = 28) => text(s, 16, y, faint, 13);

    // ===== Сцена: СПО =====
    const emitters = [
      { a: -0.9, r: 215, name: 'РЛС зенитного комплекса', sym: 'З', risk: 1 },
      { a: 0.75, r: 180, name: 'РЛС истребителя', sym: 'И', risk: 2 },
      { a: 2.4, r: 225, name: 'РЛС дальнего обзора', sym: 'О', risk: 0 },
    ];
    function sceneRwr(time: number) {
      const cx = W / 2, cy = H / 2 + 6, R = 112;
      ring(cx, cy, R, dim, 1); ring(cx, cy, R * 0.55, dim, 1, 0.6);
      for (let k = 0; k < 12; k++) {
        const a = (k / 12) * TAU;
        line(cx + Math.sin(a) * (R - 6), cy - Math.cos(a) * (R - 6), cx + Math.sin(a) * R, cy - Math.cos(a) * R, faint, 1, 0.6);
      }
      text('нос', cx, cy - R - 10, faint, 12, 'center');
      const lock = (time % 12) > 7;
      emitters.forEach((e, i) => {
        const a = e.a + time * 0.12;
        const ex = cx + Math.sin(a) * e.r, ey = cy - Math.cos(a) * e.r;
        const tracking = i === 1 && lock;
        const color = e.risk === 2 ? accent : e.risk === 1 ? blue : '#8a8a82';
        for (let k = 0; k < 3; k++) {
          const p = (time * (tracking ? 1.1 : 0.5) + k / 3) % 1;
          ring(ex, ey, p * e.r * 0.95, color, tracking ? 2 : 1, (1 - p) * 0.5);
        }
        if (tracking) line(ex, ey, cx, cy, accent, 2, 0.9);
        dot(ex, ey, 6, color); text(e.sym, ex, ey - 11, ink, 12, 'center');
        // метка на кольце СПО
        const sx = cx + Math.sin(a) * R, sy = cy - Math.cos(a) * R;
        const blink = tracking ? (Math.floor(time * 6) % 2 === 0 ? 1 : 0.35) : 1;
        ctx.save(); ctx.globalAlpha = blink;
        ctx.fillStyle = '#1a1a19'; ctx.strokeStyle = color; ctx.lineWidth = tracking ? 3 : 2;
        ctx.beginPath(); ctx.arc(sx, sy, 11, 0, TAU); ctx.fill(); ctx.stroke(); ctx.restore();
        text(e.sym, sx, sy + 4, ink, 12, 'center');
        if (tracking) text('ЗАХВАТ', sx + Math.sin(a) * 40, sy - Math.cos(a) * 30, accent, 13, 'center');
      });
      jet(cx, cy, 0, 1.3);
      caption('Метки на кольце показывают направление на излучающие станции');
      text('З зенитный комплекс   И истребитель   О радар обзора', 16, H - 16, faint, 12);
    }

    // ===== Сцена: БКО =====
    function sceneDass(time: number) {
      const P = 10, s = time % P;
      const sens = ['СПО', 'Пуск ракет (ИК/УФ)', 'Лазерное предупреждение'];
      const eff = ['Станция помех', 'Выброс ловушек', 'Рекомендация манёвра'];
      const sx = 40, sw = 170, px = 270, pw = 180, ex = 510, ew = 170;
      const rowY = (i: number) => 90 + i * 100;
      const sensorActive = s > 1.6 && s < 4.5;
      const proc = s > 3 && s < 6.2;
      const respond = s > 5.5 && s < 8.5;
      // угроза
      if (s < 2.2) {
        const k = s / 2.2;
        missile(mix(-10, 90, k), mix(0, 80, k), 0.9, accent, true);
        text('угроза', 24, 24, accent, 13);
      }
      sens.forEach((name, i) => {
        const active = sensorActive && (i !== 2 || s > 2.4);
        ctx.fillStyle = active ? 'rgba(201,133,0,0.2)' : '#20201f'; ctx.strokeStyle = active ? accent : dim; ctx.lineWidth = 2;
        ctx.fillRect(sx, rowY(i), sw, 56); ctx.strokeRect(sx, rowY(i), sw, 56);
        text(name, sx + 10, rowY(i) + 33, active ? ink : faint, 13);
        line(sx + sw, rowY(i) + 28, px, 260, active ? accent : dim, 2, active ? 1 : 0.6);
        if (active) {
          const k = clamp((s - 2) / 1.6, 0, 1);
          dot(mix(sx + sw, px, k), mix(rowY(i) + 28, 260, k), 4, accent);
        }
      });
      ctx.fillStyle = proc ? 'rgba(57,135,229,0.2)' : '#20201f'; ctx.strokeStyle = proc ? blue : dim;
      ctx.fillRect(px, 190, pw, 140); ctx.strokeRect(px, 190, pw, 140);
      text('Процессор БКО', px + 12, 214, ink, 14);
      const stage = s < 3 ? 'ожидание' : s < 4.2 ? 'приём данных' : s < 5.2 ? 'классификация' : s < 6.2 ? 'выбор ответа' : s < 8.5 ? 'ответ выдан' : 'угроза снята';
      text(stage, px + 12, 244, proc ? blue : faint, 13);
      const prog = clamp((s - 3) / 3.2, 0, 1);
      ctx.fillStyle = 'rgba(255,255,255,0.08)'; ctx.fillRect(px + 12, 282, pw - 24, 10);
      ctx.fillStyle = blue; ctx.fillRect(px + 12, 282, (pw - 24) * prog, 10);
      eff.forEach((name, i) => {
        const active = respond && (i < 2 || s > 6.2);
        ctx.fillStyle = active ? 'rgba(25,158,112,0.22)' : '#20201f'; ctx.strokeStyle = active ? '#199e70' : dim; ctx.lineWidth = 2;
        ctx.fillRect(ex, rowY(i), ew, 56); ctx.strokeRect(ex, rowY(i), ew, 56);
        text(name, ex + 10, rowY(i) + 33, active ? ink : faint, 13);
        line(px + pw, 260, ex, rowY(i) + 28, active ? '#199e70' : dim, 2, active ? 1 : 0.6);
        if (active) {
          const k = clamp((s - 5.6) / 1.4, 0, 1);
          dot(mix(px + pw, ex, k), mix(260, rowY(i) + 28, k), 4, '#199e70');
          ring(ex + ew + 20, rowY(i) + 28, 8 + ((time * 14) % 20), '#199e70', 2, 0.6);
        }
      });
      if (s > 8.4) text('угроза нейтрализована', W / 2, 470, '#199e70', 15, 'center');
      caption('Датчики → процессор → средства противодействия');
    }

    // ===== Сцены: ловушки (ИК и дипольные) =====
    const sim = { mx: 0, my: 0, mh: 0, alive: true, boom: -1, bx: 0, by: 0, flares: [] as { x: number; y: number; vx: number; vy: number; born: number }[], seed: 0 };
    function resetSim(kind: 'flare' | 'chaff') {
      sim.mx = -30; sim.my = kind === 'flare' ? 330 : 310; sim.mh = kind === 'flare' ? -0.3 : -0.15; sim.alive = true; sim.boom = -1; sim.flares = [];
    }
    function sceneDecoy(time: number, dt: number, kind: 'flare' | 'chaff') {
      const P = 9, s = time % P;
      const life = kind === 'flare' ? 3.6 : 5.5;
      if (s < dt + 0.001 || sim.mx === 0) resetSim(kind);
      const ax = 470, ay = 250 + Math.sin(time * 2) * 3;
      // линии скорости
      for (let i = 0; i < 8; i++) {
        const x = ((i * 97 - time * 220) % (W + 60) + W + 60) % (W + 60) - 30;
        line(x, 60 + i * 52, x + 40, 60 + i * 52, dim, 1, 0.5);
      }
      const turn = kind === 'chaff' && s > 2.2 ? clamp((s - 2.2) * 1.2, 0, 0.9) : 0;
      const jetY = ay - turn * 22;
      jet(ax, jetY, Math.PI / 2 - turn * 0.5, 1.7);
      const tailX = ax - 30, tailY = jetY + 4;
      const releaseT = 2.0;
      if (s > releaseT && sim.flares.length < (kind === 'flare' ? 6 : 36)) {
        const need = Math.floor((s - releaseT) * (kind === 'flare' ? 7 : 40));
        while (sim.flares.length < Math.min(need, kind === 'flare' ? 6 : 36)) {
          const n = sim.flares.length;
          sim.flares.push({ x: tailX, y: tailY, vx: -(40 + Math.random() * (kind === 'flare' ? 30 : 70)), vy: (kind === 'flare' ? 28 : (Math.random() - 0.5) * 60) + (Math.random() - 0.5) * 10, born: s + n * 0.01 });
        }
      }
      sim.flares.forEach((f) => { f.x += f.vx * dt; f.y += f.vy * dt; f.vx *= kind === 'chaff' ? 0.985 : 1; });
      sim.flares.forEach((f) => {
        const age = s - f.born;
        if (kind === 'flare') {
          if (age < life) { dot(f.x, f.y, 10, '#ffb347', 0.18); dot(f.x, f.y, 5, '#ffd27a', 0.95); }
        } else {
          dot(f.x, f.y, 2.2, '#c3c2b7', clamp(0.9 - age * 0.12, 0.15, 0.9));
        }
      });
      if (kind === 'flare') { ring(tailX + 2, tailY, 7 + Math.sin(time * 9) * 1.5, '#ffb347', 2, 0.6); }
      // цель головки
      let tx = tailX, ty = tailY;
      const live = sim.flares.filter((f) => s - f.born < life);
      if (live.length > 0 && s > releaseT + 0.55) {
        tx = live.reduce((a, f) => a + f.x, 0) / live.length; ty = live.reduce((a, f) => a + f.y, 0) / live.length;
      }
      if (sim.alive) {
        const want = Math.atan2(ty - sim.my, tx - sim.mx);
        const cur = sim.mh;
        sim.mh = cur + clamp(wrap(want - cur), -1.9 * dt, 1.9 * dt);
        sim.mx += Math.cos(sim.mh) * 120 * dt; sim.my += Math.sin(sim.mh) * 120 * dt;
        const spread = 0.2;
        ctx.save(); ctx.fillStyle = accent; ctx.globalAlpha = 0.14;
        ctx.beginPath(); ctx.moveTo(sim.mx, sim.my); ctx.arc(sim.mx, sim.my, 140, sim.mh - spread, sim.mh + spread); ctx.closePath(); ctx.fill(); ctx.restore();
        missile(sim.mx, sim.my, sim.mh + Math.PI / 2, ink, true);
        const hitFlare = live.some((f) => Math.hypot(f.x - sim.mx, f.y - sim.my) < 14) && s > releaseT + 0.8;
        const hitJet = Math.hypot(ax - sim.mx, jetY - sim.my) < 22;
        if (hitFlare) { sim.alive = false; sim.boom = s; sim.bx = sim.mx; sim.by = sim.my; }
        if (hitJet && live.length === 0) { sim.alive = false; sim.boom = s; sim.bx = sim.mx; sim.by = sim.my; }
        if (sim.mx > W + 40 || sim.my < -40 || sim.my > H + 40) sim.alive = false;
      }
      if (sim.boom >= 0) burst(sim.bx, sim.by, (s - sim.boom) / 0.8);
      // график отклика
      const bx = 20, by = 410, bw = 200;
      text(kind === 'flare' ? 'яркость в ИК диапазоне' : 'отражённый сигнал', bx, by - 10, faint, 12);
      const jetLevel = kind === 'flare' ? 0.5 : 0.45;
      const flareLevel = s < releaseT ? 0 : kind === 'flare' ? clamp((s - releaseT) * 1.2, 0, 1) * (s < releaseT + 3.6 ? 1 : 0) : clamp((s - releaseT) * 1.0, 0, 0.9) * clamp(1 - (s - releaseT - 2.2) * 0.35, 0.2, 1);
      [['самолёт', jetLevel, '#8a8a82'], [kind === 'flare' ? 'ловушки' : 'облако', flareLevel, accent]].forEach(([label, v, color], i) => {
        text(label as string, bx, by + 18 + i * 28, faint, 12);
        ctx.fillStyle = 'rgba(255,255,255,0.08)'; ctx.fillRect(bx + 70, by + 8 + i * 28, bw, 12);
        ctx.fillStyle = color as string; ctx.fillRect(bx + 70, by + 8 + i * 28, bw * (v as number), 12);
      });
      caption(kind === 'flare' ? 'Головка самонаведения идёт на самый яркий источник' : 'Облако даёт сильный отклик, но быстро рассеивается и теряет скорость');
    }

    // ===== Сцена: РЭБ =====
    const rng = (n: number) => { const x = Math.sin(n * 12.9898) * 43758.5453; return x - Math.floor(x); };
    function sceneEw(time: number) {
      const ox = W / 2, oy = H - 30, Rr = 430, sector = (55 * Math.PI) / 180;
      for (let i = 1; i <= 4; i++) { ctx.strokeStyle = dim; ctx.lineWidth = 1; ctx.beginPath(); ctx.arc(ox, oy, (Rr * i) / 4, -Math.PI / 2 - sector, -Math.PI / 2 + sector); ctx.stroke(); }
      [-sector, 0, sector].forEach((a) => line(ox, oy, ox + Math.sin(a) * Rr, oy - Math.cos(a) * Rr, dim));
      const phase = Math.floor(time / 8) % 2, s = time % 8;
      const range = 0.92 - clamp(s / 8, 0, 1) * 0.68;
      const bearing = 0.2;
      const tx = ox + Math.sin(bearing) * range * Rr, ty = oy - Math.cos(bearing) * range * Rr;
      const burn = range < 0.34;
      if (phase === 0) {
        // шумовая помеха: полоса шума вдоль направления
        for (let i = 0; i < 700; i++) {
          const rr = rng(i + Math.floor(time * 12) * 1000) * Rr;
          const aa = bearing + (rng(i * 3 + Math.floor(time * 12) * 77) - 0.5) * 0.2;
          const x = ox + Math.sin(aa) * rr, y = oy - Math.cos(aa) * rr;
          dot(x, y, 1.4, ink, 0.12 + rng(i * 7) * 0.4);
        }
        if (burn || rng(Math.floor(time * 10)) > 0.97) { dot(tx, ty, 5, ink); ring(tx, ty, 12, accent, 2); text('выгорание: цель видна', tx + 16, ty, accent, 13); }
        else text('цель скрыта шумом', ox + Math.sin(bearing) * 260 + 28, oy - Math.cos(bearing) * 260, faint, 13);
        caption('Шумовая помеха: широкополосный сигнал заливает приёмник по направлению на цель');
      } else {
        // обманная помеха: ложные отметки
        for (let k = 0; k < 4; k++) {
          const rr = (range + 0.12 + k * 0.1 + Math.sin(time * (1.2 + k * 0.4) + k) * 0.06) % 0.98;
          const aa = bearing + (k - 1.5) * 0.015;
          const x = ox + Math.sin(aa) * rr * Rr, y = oy - Math.cos(aa) * rr * Rr;
          ctx.save(); ctx.globalAlpha = 0.55; ctx.strokeStyle = ink; ctx.setLineDash([3, 3]);
          ctx.strokeRect(x - 8, y - 8, 16, 16); ctx.restore();
        }
        dot(tx, ty, 5, ink); ring(tx, ty, 13, accent, 2);
        text('настоящая цель', tx + 18, ty + 4, accent, 13);
        text('ложные отметки', ox + 150, oy - 330, faint, 13);
        caption('Обманная помеха: ложные отметки по дальности и скорости вместо одной цели');
      }
      text(phase === 0 ? 'режим: шумовая помеха' : 'режим: обманная помеха', W - 16, 28, ink, 13, 'right');
      text(`дальность до цели: ${(range * 100).toFixed(0)} усл. ед.`, W - 16, 48, faint, 12, 'right');
      ctx.fillStyle = ink; ctx.beginPath(); ctx.moveTo(ox - 8, oy + 8); ctx.lineTo(ox, oy - 8); ctx.lineTo(ox + 8, oy + 8); ctx.fill();
    }

    // ===== Сцена: КАЗ =====
    function sceneAps(time: number) {
      const cx = W / 2, cy = H / 2 + 20;
      const P = 6.4, k = Math.floor(time / P), s = time % P;
      const hard = k % 2 === 0;
      const angles = [-0.9, 0.6, 2.2, -2.4];
      const a = angles[k % angles.length];
      tank(cx, cy, 0);
      const R0 = 300, speed = 140;
      let dist = R0 - speed * s;
      const detectDist = 175, killDist = 80;
      const detected = dist < detectDist;
      // кольцо датчиков
      ring(cx, cy, 70, dim, 1, 0.8);
      for (let i = 0; i < 2; i++) ring(cx, cy, 60 + (((time * 40) + i * 40) % 80), blue, 1, 0.25);
      if (detected) {
        ctx.save(); ctx.strokeStyle = accent; ctx.lineWidth = 4; ctx.beginPath();
        ctx.arc(cx, cy, 78, -Math.PI / 2 + a - 0.35, -Math.PI / 2 + a + 0.35); ctx.stroke(); ctx.restore();
      }
      let px = cx + Math.sin(a) * dist, py = cy - Math.cos(a) * dist;
      let drawProj = true;
      if (hard) {
        if (dist <= killDist) { drawProj = false; burst(cx + Math.sin(a) * killDist, cy - Math.cos(a) * killDist, (s - (R0 - killDist) / speed) / 0.7); }
        else if (detected) {
          const kk = clamp((detectDist - dist) / (detectDist - killDist), 0, 1);
          const ox = cx + Math.sin(a) * 52, oy = cy - Math.cos(a) * 52;
          const ix = mix(ox, cx + Math.sin(a) * killDist, kk), iy = mix(oy, cy - Math.cos(a) * killDist, kk);
          dot(ix, iy, 4, '#199e70'); line(ox, oy, ix, iy, '#199e70', 1, 0.5);
        }
        caption('Жёсткое поражение: контрбоеприпас разрушает угрозу на подлёте');
      } else {
        if (detected) {
          const kk = clamp((detectDist - dist) / 100, 0, 1);
          for (let i = 0; i < 6; i++) {
            const ang = (i / 6) * TAU;
            dot(cx + Math.cos(ang) * (30 + kk * 55), cy + Math.sin(ang) * (30 + kk * 50), 16 + kk * 22, '#8a8a82', 0.32 * kk);
          }
          // отклонение пролёта
          const off = clamp(kk, 0, 1) * 0.5;
          const aa = a + off * (a > 0 ? 1 : -1);
          px = cx + Math.sin(aa) * dist; py = cy - Math.cos(aa) * dist;
        }
        caption('Мягкое поражение: дымовая завеса и помехи сбивают наведение');
      }
      if (drawProj && dist > -40) {
        const dir = Math.atan2(cy - py, cx - px);
        missile(px, py, dir + Math.PI / 2, ink, true);
      }
      if (detected && s < P - 0.6) text('цель обнаружена', cx, 56, accent, 14, 'center');
      text(hard ? 'режим: жёсткое поражение' : 'режим: мягкое поражение', W - 16, 28, ink, 13, 'right');
    }

    // ===== Сцена: корабль =====
    function sceneShip(time: number) {
      const cx = W / 2, cy = H / 2 + 10, P = 12, s = time % P;
      const radii = [200, 135, 70];
      const names = ['дальний рубеж', 'средний рубеж', 'ближний рубеж'];
      radii.forEach((r, i) => { ring(cx, cy, r, dim, 1, 0.9, [5, 5]); text(names[i], cx + r * 0.7 + 6, cy - r * 0.7 - 6, faint, 11); });
      ship(cx, cy, 0, 1.3);
      const threats = [
        { a: -0.8, t0: 0.4, kind: 'far' },
        { a: 1.0, t0: 2.0, kind: 'mid' },
        { a: 2.4, t0: 3.6, kind: 'close' },
        { a: -2.3, t0: 5.2, kind: 'decoy' },
      ];
      const v = 105;
      threats.forEach((m) => {
        const ts = s - m.t0;
        if (ts < 0) return;
        let dist = 310 - v * ts;
        const stop = m.kind === 'far' ? 200 : m.kind === 'mid' ? 135 : m.kind === 'close' ? 70 : 0;
        let ang = m.a;
        if (m.kind === 'decoy') {
          if (dist < 150) {
            const kk = clamp((150 - dist) / 100, 0, 1);
            ang += kk * 0.55;
            const dx = cx + Math.sin(m.a + 0.9) * 55, dy = cy - Math.cos(m.a + 0.9) * 55;
            for (let i = 0; i < 5; i++) dot(dx + Math.cos(i * 1.3) * 22 * kk, dy + Math.sin(i * 1.3) * 18 * kk, 16 * kk, '#c3c2b7', 0.28);
            text('ложная цель', dx, dy - 28, accent, 12, 'center');
          }
          if (dist < -20) return;
        } else if (dist <= stop) {
          const killT = (310 - stop) / v;
          const kk = (ts - killT) / 0.7;
          const bx = cx + Math.sin(ang) * stop, by = cy - Math.cos(ang) * stop;
          burst(bx, by, kk);
          if (kk < 0.2 && m.kind !== 'close') line(cx, cy, bx, by, '#199e70', 2, 0.8);
          if (m.kind === 'close' && kk < 0.6) {
            for (let i = 0; i < 10; i++) {
              const q = (i / 10 + time * 4) % 1;
              dot(mix(cx, bx, q), mix(cy, by, q), 2, '#ffd27a', 0.8);
            }
          }
          return;
        }
        if (m.kind === 'close' && dist < 150 && dist > stop) {
          for (let i = 0; i < 8; i++) {
            const q = (i / 8 + time * 5) % 1;
            dot(mix(cx, cx + Math.sin(ang) * dist, q), mix(cy, cy - Math.cos(ang) * dist, q), 1.8, '#ffd27a', 0.6);
          }
        }
        const x = cx + Math.sin(ang) * dist, y = cy - Math.cos(ang) * dist;
        missile(x, y, Math.atan2(cy - y, cx - x) + Math.PI / 2, ink, true);
        if (m.kind === 'far' && dist < 260 && dist > stop) { dot(cx, cy, 3, '#199e70'); line(cx, cy, mix(cx, x, 0.4), mix(cy, y, 0.4), '#199e70', 2, 0.7); }
        if (m.kind === 'mid' && dist < 190 && dist > stop) { line(cx, cy, mix(cx, x, 0.5), mix(cy, y, 0.5), '#199e70', 2, 0.7); }
      });
      caption('Угрозы встречают на разных рубежах: от дальнего к ближнему');
      text('зелёная линия: пуск ракеты-перехватчика, жёлтая: огонь пушки', 16, H - 16, faint, 12);
    }

    function frame(dt: number) {
      ctx.fillStyle = '#1a1a19'; ctx.fillRect(0, 0, W, H);
      switch (current) {
        case 'rwr': sceneRwr(t); break;
        case 'dass': sceneDass(t); break;
        case 'flare': sceneDecoy(t, dt, 'flare'); break;
        case 'chaff': sceneDecoy(t, dt, 'chaff'); break;
        case 'ew': sceneEw(t); break;
        case 'aps': sceneAps(t); break;
        case 'ship': sceneShip(t); break;
      }
    }

    function setScene(id: SceneId) {
      current = id; t = 0; sim.mx = 0;
      tabs.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.scene === id)));
      const info = scenes.find((sc) => sc.id === id)!;
      root.querySelector('.radar-title')!.textContent = `${info.short}: ${info.name}`;
      root.querySelector('.radar-text')!.textContent = info.text;
      (['d-1', 'd-2', 'd-3'] as const).forEach((c, i) => { root.querySelector('.' + c)!.textContent = info.readout[i]; });
      if (paused) { t = 3.2; frame(0.016); }
    }

    function loop(now: number) {
      const dt = Math.min(0.05, (now - last) / 1000); last = now;
      if (!paused) { t += dt; frame(dt); }
      requestAnimationFrame(loop);
    }

    tabs.forEach((b) => b.addEventListener('click', () => setScene(b.dataset.scene as SceneId)));
    toggle.textContent = paused ? 'Запустить' : 'Пауза';
    toggle.setAttribute('aria-pressed', String(paused));
    toggle.addEventListener('click', () => {
      paused = !paused;
      toggle.textContent = paused ? 'Запустить' : 'Пауза';
      toggle.setAttribute('aria-pressed', String(paused));
    });
    setScene(current);
    requestAnimationFrame(loop);
  }

  document.querySelectorAll<HTMLElement>('[data-defense]').forEach(init);
</script>
