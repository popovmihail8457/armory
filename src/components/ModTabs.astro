---
import type { WeaponMod } from '../data/weapons/mods';
import { basisLabel, type WeaponCost } from '../data/weapons/costs';
import { moneyRange } from '../lib/money';

interface Props {
  mods: WeaponMod[];
  cost?: WeaponCost;
}

const { mods, cost } = Astro.props;
const hasCost = cost && cost.ranges.length === mods.length;
const allValues = hasCost ? cost!.ranges.flat() : [];
const logMin = hasCost ? Math.log10(Math.max(0.1, Math.min(...allValues))) : 0;
const logMax = hasCost ? Math.log10(Math.max(...allValues)) : 1;
const pos = (v: number) => (logMax === logMin ? 50 : ((Math.log10(Math.max(0.1, v)) - logMin) / (logMax - logMin)) * 92 + 4);
---
<div class="mods" data-mods>
  <div class="mod-tabs" role="tablist" aria-label="Модификации">
    <span class="mod-track" aria-hidden="true"><i class="mod-fill"></i></span>
    {mods.map((mod, i) => (
      <button type="button" role="tab" id={`mod-tab-${i}`} class="mod-tab" data-i={i} aria-controls={`mod-panel-${i}`} aria-selected={i === 0} tabindex={i === 0 ? 0 : -1}>
        <span class="mod-dot" aria-hidden="true"></span>
        <span class="mod-name">{mod.name}</span>
        {mod.years && <span class="mod-years num">{mod.years}</span>}
      </button>
    ))}
  </div>
  <div class="mod-panels">
    {mods.map((mod, i) => (
      <article class="mod-panel" role="tabpanel" id={`mod-panel-${i}`} aria-labelledby={`mod-tab-${i}`} hidden={i !== 0}>
        <header>
          <h3>{mod.name}</h3>
          {mod.years && <span class="meta num">{mod.years}</span>}
        </header>
        <p class="mod-summary">{mod.summary}</p>
        <div class="mod-diff">
          <span class="eyebrow">{i === 0 ? 'Что принципиально нового' : `Чем отличается от ${mods[i - 1].name}`}</span>
          <p>{mod.diff}</p>
        </div>
        {hasCost && (
          <div class="mod-cost">
            <span class="eyebrow">Стоимость единицы</span>
            <strong class="num">{moneyRange(cost!.ranges[i][0], cost!.ranges[i][1])}</strong>
            <small>Оценка, не прайс. Цены порядка {cost!.year} года, {basisLabel[cost!.basis]}.</small>
          </div>
        )}
      </article>
    ))}
  </div>
  {hasCost && (
    <figure class="cost-chart" aria-label="Стоимость по версиям, логарифмическая шкала">
      <figcaption class="eyebrow">Стоимость по версиям (логарифмическая шкала, тыс. $)</figcaption>
      <ul>
        {mods.map((mod, i) => (
          <li data-i={i} class={i === 0 ? 'active' : ''}>
            <span class="cost-name">{mod.name}</span>
            <span class="cost-track"><i style={`left:${pos(cost!.ranges[i][0])}%;width:${Math.max(1.5, pos(cost!.ranges[i][1]) - pos(cost!.ranges[i][0]))}%`}></i></span>
            <span class="cost-val num">{moneyRange(cost!.ranges[i][0], cost!.ranges[i][1])}</span>
          </li>
        ))}
      </ul>
    </figure>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-mods]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.mod-tab')];
    const panels = [...root.querySelectorAll<HTMLElement>('.mod-panel')];
    const rows = [...root.querySelectorAll<HTMLElement>('.cost-chart li')];
    const track = root.querySelector<HTMLElement>('.mod-track')!;
    const fill = root.querySelector<HTMLElement>('.mod-fill')!;
    const dotX = (i: number) => tabs[i].offsetLeft + 29;
    const layoutTrack = () => {
      track.style.left = dotX(0) + 'px';
      track.style.width = Math.max(0, dotX(tabs.length - 1) - dotX(0)) + 'px';
    };
    let current = 0;
    const select = (index: number, focus = false) => {
      const forward = index >= current;
      layoutTrack();
      fill.style.width = Math.max(0, dotX(index) - dotX(0)) + 'px';
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        tab.classList.toggle('past', i < index);
        const dot = tab.querySelector<HTMLElement>('.mod-dot');
        if (dot) dot.style.setProperty('--d', (forward ? i * 0.1 : (tabs.length - i) * 0.08) + 's');
        panels[i].hidden = !on;
      });
      current = index;
      rows.forEach((row, i) => row.classList.toggle('active', i === index));
      root.dispatchEvent(new CustomEvent('modselect', { detail: { index }, bubbles: true }));
      if (focus) tabs[index].focus();
    };
    layoutTrack();
    window.addEventListener('resize', () => { layoutTrack(); fill.style.width = Math.max(0, dotX(current) - dotX(0)) + 'px'; });
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') { event.preventDefault(); select((i + 1) % tabs.length, true); }
        if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') { event.preventDefault(); select((i - 1 + tabs.length) % tabs.length, true); }
      });
    });
    rows.forEach((row, i) => row.addEventListener('click', () => select(i)));
  });
</script>
