---
import type { LaunchScene } from '../data/ships';

interface Props {
  scenes: LaunchScene[];
}

const { scenes } = Astro.props;
const names: Record<LaunchScene, string> = {
  'vls-hot': 'Вертикальный горячий старт',
  'vls-cold': 'Вертикальный холодный старт',
  cruise: 'Крылатая ракета',
  canister: 'Противокорабельная ракета',
  rail: 'Поворотная пусковая',
  sub: 'Пуск из-под воды',
};
---
<section class="radar naval" data-naval data-scenes={JSON.stringify(scenes)}>
  {scenes.length > 1 && (
    <div class="radar-tabs" role="tablist" aria-label="Схемы пуска">
      {scenes.map((scene, i) => <button type="button" role="tab" class="radar-tab" data-scene={scene} aria-selected={i === 0}>{names[scene]}</button>)}
    </div>
  )}
  <div class="radar-body">
    <div class="radar-stage">
      <canvas class="radar-canvas" width="760" height="440" role="img" aria-label="Схема выхода ракеты на траекторию"></canvas>
      <button type="button" class="radar-toggle" aria-pressed="false">Пауза</button>
    </div>
    <div class="radar-info">
      <h3 class="radar-title naval-title"></h3>
      <p class="radar-text naval-text"></p>
      <ol class="naval-stages"></ol>
    </div>
  </div>
</section>

<script>
  type Pt = [number, number, number];
  interface Scene {
    title: string;
    text: string;
    stages: [number, string][];
    path: Pt[];
    flame: [number, number];
    drop?: number;
    launcher: 'vls' | 'canister' | 'rail' | 'sub';
    target: 'air' | 'ship' | 'land' | 'none';
    puff?: [number, number];
  }

  const SEA = 300;
  const SCENES: Record<string, Scene> = {
    'vls-hot': {
      title: 'Вертикальный горячий старт',
      text: 'Двигатель включается прямо в ячейке, раскалённые газы отводятся вверх по каналу между ячейками. Ракета выходит вертикально и уже над кораблём разворачивается в нужную сторону, поэтому пусковая не поворачивается и готова к пуску в любом направлении.',
      stages: [[0.12, 'Запуск двигателя в ячейке'], [0.22, 'Вертикальный подъём'], [0.4, 'Склонение в сторону цели'], [1, 'Полёт в точку встречи']],
      path: [[0, 150, 282], [0.12, 150, 215], [0.22, 160, 165], [0.35, 215, 120], [1, 640, 60]],
      flame: [0, 1], launcher: 'vls', target: 'air',
    },
    'vls-cold': {
      title: 'Вертикальный холодный старт',
      text: 'Ракету выбрасывает из контейнера пороховой аккумулятор давления или поршень. Двигатель включается на высоте в два-три десятка метров, а наклон в сторону цели задают импульсные двигатели или газовые рули. Если двигатель не запустится, ракета упадёт в воду, а не останется в корабле.',
      stages: [[0.12, 'Выброс из контейнера без двигателя'], [0.2, 'Запуск двигателя над палубой'], [0.42, 'Склонение в сторону цели'], [1, 'Полёт в точку встречи']],
      path: [[0, 150, 282], [0.1, 150, 236], [0.18, 152, 222], [0.3, 180, 170], [0.42, 235, 125], [1, 640, 60]],
      flame: [0.16, 1], launcher: 'vls', target: 'air', puff: [0.1, 0.22],
    },
    cruise: {
      title: 'Крылатая ракета',
      text: 'Ускоритель поднимает ракету и разгоняет до скорости, на которой работает крыло. Затем он сбрасывается, раскрываются крылья и включается турбореактивный двигатель. Ракета снижается и летит на малой высоте, над сушей огибая рельеф.',
      stages: [[0.2, 'Вертикальный старт с ускорителем'], [0.32, 'Сброс ускорителя, раскрытие крыльев'], [0.52, 'Снижение на малую высоту'], [1, 'Полёт с огибанием рельефа']],
      path: [[0, 150, 282], [0.1, 150, 200], [0.2, 175, 140], [0.3, 235, 120], [0.42, 320, 180], [0.52, 390, 268], [0.66, 480, 268], [0.76, 545, 236], [0.88, 625, 244], [1, 715, 234]],
      flame: [0, 0.28], drop: 0.28, launcher: 'vls', target: 'land',
    },
    canister: {
      title: 'Противокорабельная ракета',
      text: 'Ракета стартует из наклонного контейнера на твёрдотопливном ускорителе. После сброса ускорителя включается маршевый двигатель, ракета снижается и идёт над самой водой, оставаясь под радиогоризонтом цели почти до конца полёта.',
      stages: [[0.14, 'Старт из наклонного контейнера'], [0.26, 'Сброс ускорителя'], [0.46, 'Снижение к воде'], [1, 'Полёт на малой высоте до цели']],
      path: [[0, 190, 278], [0.14, 262, 226], [0.24, 330, 212], [0.36, 400, 268], [0.46, 440, 288], [0.9, 665, 288], [1, 700, 284]],
      flame: [0, 0.2], drop: 0.2, launcher: 'canister', target: 'ship',
    },
    rail: {
      title: 'Поворотная пусковая установка',
      text: 'Пусковая сначала разворачивается и поднимается в сторону цели, затем ракета сходит с направляющей или из контейнера уже в нужном направлении. Схема проще, но требует времени на наведение и перезарядку и имеет мёртвые зоны, закрытые надстройками.',
      stages: [[0.08, 'Наведение пусковой на цель'], [0.2, 'Сход с направляющей'], [1, 'Полёт в точку встречи']],
      path: [[0, 170, 268], [0.08, 170, 268], [0.2, 235, 214], [1, 640, 70]],
      flame: [0.08, 1], launcher: 'rail', target: 'air',
    },
    sub: {
      title: 'Пуск из-под воды',
      text: 'Ракету выталкивает из шахты давление газа, и она поднимается к поверхности в газовом пузыре. Двигатель включается только после выхода из воды. Так лодка может стрелять, не всплывая.',
      stages: [[0.18, 'Выброс из шахты давлением газа'], [0.26, 'Выход из воды'], [0.4, 'Запуск двигателя над поверхностью'], [1, 'Разгон и выход на траекторию']],
      path: [[0, 170, 356], [0.18, 170, 300], [0.26, 170, 262], [0.4, 190, 180], [0.55, 262, 110], [1, 720, 36]],
      flame: [0.24, 1], launcher: 'sub', target: 'none',
    },
  };
  const LAND: [number, number][] = [[455, SEA], [485, 286], [545, 254], [585, 262], [625, 262], [690, 250], [760, 256], [760, SEA]];
  const LOOP = 7.5;
  const HOLD = 1.2;

  function at(path: Pt[], t: number): { x: number; y: number; angle: number } {
    const point = (u: number) => {
      const v = Math.min(1, Math.max(0, u));
      let i = 0;
      while (i < path.length - 2 && path[i + 1][0] < v) i += 1;
      const [t0, x0, y0] = path[i];
      const [t1, x1, y1] = path[i + 1];
      const k = t1 === t0 ? 0 : (v - t0) / (t1 - t0);
      const prev = path[Math.max(0, i - 1)];
      const next = path[Math.min(path.length - 1, i + 2)];
      const spline = (a: number, b: number, c: number, d: number) => 0.5 * (2 * b + (c - a) * k + (2 * a - 5 * b + 4 * c - d) * k * k + (3 * b - a - 3 * c + d) * k * k * k);
      return { x: spline(prev[1], x0, x1, next[1]), y: spline(prev[2], y0, y1, next[2]) };
    };
    const a = point(t);
    const b = point(t + 0.01);
    const c = point(t - 0.01);
    return { ...a, angle: Math.atan2(b.y - c.y, b.x - c.x) };
  }

  document.querySelectorAll<HTMLElement>('[data-naval]').forEach((root) => {
    const ids: string[] = JSON.parse(root.dataset.scenes ?? '[]');
    if (ids.length === 0) return;
    const canvas = root.querySelector<HTMLCanvasElement>('canvas')!;
    const ctx = canvas.getContext('2d')!;
    const css = getComputedStyle(root);
    const color = (name: string) => css.getPropertyValue(name).trim();
    const accent = color('--era-modern') || '#c98500';
    const toggle = root.querySelector<HTMLButtonElement>('.radar-toggle')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-scene]')];
    const stageList = root.querySelector<HTMLOListElement>('.naval-stages')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let scene = SCENES[ids[0]];
    let clock = reduce ? LOOP * 0.6 : 0;
    let paused = reduce;
    let last = 0;
    let activeStage = -1;

    function drawSea() {
      ctx.fillStyle = 'rgba(57, 135, 229, 0.12)';
      ctx.fillRect(0, SEA, canvas.width, canvas.height - SEA);
      ctx.strokeStyle = 'rgba(57, 135, 229, 0.6)';
      ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.moveTo(0, SEA); ctx.lineTo(canvas.width, SEA); ctx.stroke();
    }

    function drawShip(x: number, scale = 1) {
      ctx.fillStyle = color('--surface-2');
      ctx.strokeStyle = color('--text-2');
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(x - 110 * scale, 282); ctx.lineTo(x - 95 * scale, SEA + 6); ctx.lineTo(x + 100 * scale, SEA + 6); ctx.lineTo(x + 125 * scale, 280); ctx.closePath();
      ctx.fill(); ctx.stroke();
      ctx.fillRect(x - 70 * scale, 262, 60 * scale, 20); ctx.strokeRect(x - 70 * scale, 262, 60 * scale, 20);
      ctx.beginPath(); ctx.moveTo(x - 45 * scale, 262); ctx.lineTo(x - 45 * scale, 236); ctx.stroke();
    }

    function drawLauncher() {
      ctx.strokeStyle = accent;
      ctx.fillStyle = accent;
      ctx.lineWidth = 2;
      if (scene.launcher === 'vls') { ctx.fillRect(138, 279, 24, 4); }
      if (scene.launcher === 'canister') { ctx.save(); ctx.translate(182, 280); ctx.rotate(-0.62); ctx.strokeRect(-4, -5, 30, 10); ctx.restore(); }
      if (scene.launcher === 'rail') {
        const aim = Math.min(1, clock / LOOP / 0.08);
        ctx.save(); ctx.translate(166, 272); ctx.rotate(-0.1 - 0.6 * aim); ctx.strokeRect(-4, -5, 28, 10); ctx.restore();
        ctx.beginPath(); ctx.moveTo(166, 272); ctx.lineTo(166, 282); ctx.stroke();
      }
    }

    function drawSub() {
      ctx.fillStyle = color('--surface-2');
      ctx.strokeStyle = color('--text-2');
      ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.ellipse(170, 376, 130, 18, 0, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
      ctx.fillRect(110, 344, 34, 18); ctx.strokeRect(110, 344, 34, 18);
      ctx.fillStyle = accent; ctx.fillRect(160, 356, 20, 3);
    }

    function drawTarget(t: number) {
      ctx.fillStyle = color('--text');
      ctx.strokeStyle = color('--text');
      if (scene.target === 'air') {
        const end = scene.path[scene.path.length - 1];
        const x = end[1] + (1 - t) * 90;
        const y = end[2] - (1 - t) * 8;
        if (t < 0.985) { ctx.beginPath(); ctx.moveTo(x - 12, y); ctx.lineTo(x + 10, y - 4); ctx.lineTo(x + 10, y + 4); ctx.closePath(); ctx.fill(); }
      }
      if (scene.target === 'ship') drawShip(735, 0.45);
      if (scene.target === 'land') {
        ctx.fillStyle = color('--surface-2'); ctx.strokeStyle = color('--text-3'); ctx.lineWidth = 1.5;
        ctx.beginPath(); LAND.forEach(([x, y], i) => (i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y))); ctx.closePath(); ctx.fill(); ctx.stroke();
        ctx.fillStyle = color('--text'); ctx.fillRect(712, 240, 14, 12);
      }
    }

    function drawFlight(t: number) {
      ctx.strokeStyle = accent;
      ctx.lineWidth = 2;
      ctx.setLineDash([6, 5]);
      ctx.beginPath();
      for (let u = 0; u <= t; u += 0.01) { const p = at(scene.path, u); if (u === 0) ctx.moveTo(p.x, p.y); else ctx.lineTo(p.x, p.y); }
      ctx.stroke();
      ctx.setLineDash([]);

      if (scene.drop !== undefined && t > scene.drop) {
        const from = at(scene.path, scene.drop);
        const dt = (t - scene.drop) * 9;
        const y = Math.min(SEA, from.y + 60 * dt * dt);
        ctx.fillStyle = color('--text-3');
        ctx.save(); ctx.translate(from.x + 18 * dt, y); ctx.rotate(dt * 2); ctx.fillRect(-7, -2.5, 14, 5); ctx.restore();
      }
      if (scene.puff && t > scene.puff[0] && t < scene.puff[1]) {
        const p = at(scene.path, t);
        ctx.fillStyle = 'rgba(242, 241, 236, 0.5)';
        ctx.beginPath(); ctx.arc(p.x - 10, p.y - 4, 4, 0, Math.PI * 2); ctx.fill();
      }
      if (scene.launcher === 'sub' && t < 0.26) {
        const p = at(scene.path, t);
        ctx.strokeStyle = 'rgba(242, 241, 236, 0.45)';
        ctx.lineWidth = 1;
        for (let i = 0; i < 6; i += 1) { ctx.beginPath(); ctx.arc(p.x + Math.sin(i * 2.4 + t * 40) * 9, Math.min(372, p.y + 12 + i * 9), 3, 0, Math.PI * 2); ctx.stroke(); }
      }
      if (t >= 0.985 && scene.target !== 'none') {
        const end = at(scene.path, 1);
        ctx.strokeStyle = color('--text'); ctx.lineWidth = 2;
        ctx.beginPath(); ctx.arc(end.x, end.y, 6 + (t - 0.985) * 900, 0, Math.PI * 2); ctx.stroke();
        return;
      }
      const p = at(scene.path, t);
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.angle);
      if (t >= scene.flame[0] && t <= scene.flame[1]) {
        ctx.fillStyle = '#d95926';
        ctx.beginPath(); ctx.moveTo(-9, -3); ctx.lineTo(-22 - Math.random() * 8, 0); ctx.lineTo(-9, 3); ctx.closePath(); ctx.fill();
      } else if (scene.drop !== undefined && t > scene.drop) {
        ctx.fillStyle = 'rgba(217, 89, 38, 0.7)';
        ctx.beginPath(); ctx.moveTo(-9, -2); ctx.lineTo(-15, 0); ctx.lineTo(-9, 2); ctx.closePath(); ctx.fill();
        ctx.strokeStyle = color('--text'); ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.moveTo(-2, -7); ctx.lineTo(-2, 7); ctx.stroke();
      }
      ctx.fillStyle = color('--text');
      ctx.beginPath(); ctx.moveTo(11, 0); ctx.lineTo(5, -3); ctx.lineTo(-9, -3); ctx.lineTo(-9, 3); ctx.lineTo(5, 3); ctx.closePath(); ctx.fill();
      ctx.restore();
    }

    function markStage(t: number) {
      const index = scene.stages.findIndex(([until]) => t <= until);
      if (index === activeStage) return;
      activeStage = index;
      [...stageList.children].forEach((li, i) => li.classList.toggle('active', i === index));
    }

    function frame(now: number) {
      if (!paused) clock += (now - (last || now)) / 1000;
      last = now;
      if (clock > LOOP + HOLD) clock = 0;
      const t = Math.min(1, clock / LOOP);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      drawSea();
      drawTarget(t);
      if (scene.launcher === 'sub') drawSub(); else { drawShip(160); drawLauncher(); }
      drawFlight(t);
      markStage(t);
      if (!reduce) requestAnimationFrame(frame);
    }

    function select(id: string) {
      scene = SCENES[id];
      clock = reduce ? LOOP * 0.6 : 0;
      activeStage = -1;
      tabs.forEach((tab) => tab.setAttribute('aria-selected', String(tab.dataset.scene === id)));
      root.querySelector('.naval-title')!.textContent = scene.title;
      root.querySelector('.naval-text')!.textContent = scene.text;
      stageList.replaceChildren(...scene.stages.map(([, label]) => { const li = document.createElement('li'); li.textContent = label; return li; }));
      if (reduce) requestAnimationFrame(frame);
    }

    tabs.forEach((tab) => tab.addEventListener('click', () => select(tab.dataset.scene!)));
    toggle.hidden = reduce;
    toggle.addEventListener('click', () => {
      paused = !paused;
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.textContent = paused ? 'Продолжить' : 'Пауза';
    });
    select(ids[0]);
    if (!reduce) requestAnimationFrame(frame);
  });
</script>
